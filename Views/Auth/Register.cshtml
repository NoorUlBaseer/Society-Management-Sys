@model SocietyMng.Models.Auth.RegisterModel

@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kokoro&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(to bottom, black, #408350);
            color: white;
            position: relative;
            font-family: 'Kokoro', sans-serif !important;
        }

        h1, .display-4 {
            font-family: 'Julius Sans One', sans-serif !important;
            font-size: 2rem;
        }

        .lead {
            font-size: 1rem;
        }

        .left-pane {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding-left: 5rem;
            z-index: 10;
        }

        .left-side-wrapper {
            max-width: 500px;
            display: flex;
            flex-direction: column;
            padding-left: 70px;
        }

        .items {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center !important;
        }

        .register-container {
            border-radius: 50px;
            padding: 2rem;
        }

        .building-img {
            position: absolute;
            bottom: 0;
            right: 0;
            max-height: 70vh;
            opacity: 0.8;
            z-index: 1;
        }

        .form-label, .form-control, .form-check-label, .form-check-input {
            color: #D9D9D980;
        }

            .form-control::placeholder {
                color: #ccc;
            }

        .form-control {
            background-color: #D9D9D980;
            border-color: #666;
            border-radius: 30px;
            padding-right: 2.5rem;
            color: white;
        }

            .form-control:focus {
                background-color: #D9D9D980 !important;
                color: white !important;
                border-color: #666 !important;
                box-shadow: none !important;
            }

        .btn-primary {
            background-color: #D9D9D9;
            border-radius: 30px;
            border: none;
            width: 150px;
            margin: 0 auto;
            display: block;
            color: black;
        }

            .btn-primary:hover {
                background-color: #2d5f38;
            }

        .small-text {
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <div class="left-pane">
        <div class="left-side-wrapper">
            <div class="items">
                <h1 class="display-4 fw-bold">CivicNest</h1>
                <p class="lead">Register to explore plots and homes, manage your bookings, and stay updated with announcements.</p>
            </div>

            <div class="register-container">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-2">
                        <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-2">
                        <input asp-for="Email" class="form-control" placeholder="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-2">
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-2">
                        <select asp-for="Gender" asp-items="Model.GenderOptions" class="form-control" style="color: black !important;">
                            <option value="" disabled selected>--Select Gender--</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-2">
                        <select asp-for="SelectedRole" asp-items="Model.GetRoleOptions()" class="form-control" style="color: black !important;">
                            <option value="">Select Role</option>
                        </select>
                        <span asp-validation-for="SelectedRole" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-2">
                        <div class="position-relative">
                            <input asp-for="Password" type="@(Model.ShowPassword ? "text" : "password")" class="form-control pe-5" id="passwordInput" placeholder="Password" />
                            <i class="bi bi-eye" id="passwordToggleIcon1" style="cursor: pointer; position: absolute; top: 50%; right: 16px; transform: translateY(-50%); font-size: 1.2rem; color: black;"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-2">
                        <div class="position-relative">
                            <input asp-for="ConfirmPassword" type="@(Model.ShowPassword ? "text" : "password")" class="form-control pe-5" id="confirmPasswordInput" placeholder="Confirm Password" />
                            <i class="bi bi-eye" id="passwordToggleIcon2" style="cursor: pointer; position: absolute; top: 50%; right: 16px; transform: translateY(-50%); font-size: 1.2rem; color: black;"></i>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div>
                        <button type="submit" class="btn btn-primary">Register</button>
                    </div>
                </form>

                <div class="mt-2 text-center small-text">
                    <p>Already have an account? <a asp-action="Login" class="text-light text-decoration-underline">Login here</a></p>
                </div>

            </div>
        </div>
    </div>

    <img src="~/images/building1.png" alt="Building" class="building-img" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        document.getElementById('passwordToggleIcon1').addEventListener('click', function () {
            const input = document.getElementById('passwordInput');
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            this.classList.toggle('bi-eye');
            this.classList.toggle('bi-eye-slash');
        });

        document.getElementById('passwordToggleIcon2').addEventListener('click', function () {
            const input = document.getElementById('confirmPasswordInput');
            const isPassword = input.type === 'password';
            input.type = isPassword ? 'text' : 'password';
            this.classList.toggle('bi-eye');
            this.classList.toggle('bi-eye-slash');
        });


        document.addEventListener("DOMContentLoaded", function () {
            const genderSelect = document.querySelector('select[name="Gender"]');
            if (genderSelect) {
                genderSelect.value = "";
            }
        });
    </script>
</body>
</html>
