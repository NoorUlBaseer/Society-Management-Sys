@{
    ViewData["Title"] = "Upload Image";
}

<h2>Upload an Image</h2>

<form asp-controller="Home" asp-action="Analyze" method="post" enctype="multipart/form-data">
    <input type="file" name="imageFile" accept="image/*" required />
    <button type="submit">Analyze</button>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <p style="color:red">@ViewData.ModelState.Values.FirstOrDefault()?.Errors.FirstOrDefault()?.ErrorMessage</p>
}
