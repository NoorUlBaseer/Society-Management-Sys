@model SocietyMng.Data.Entities.Asset
@{
    ViewData["Title"] = "Asset Details";
    Layout = "_AdminLayout";
}
<h1 class="mt-4">Manage Assets</h1>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Asset Details</h1>
        <div>
            <a href="@Url.Action("Edit", "Asset", new { area = "Admin", id = @Model.Id })">
                <i class="fas fa-edit me-1"></i>Edit
            </a>
            <form action="@Url.Action("Delete", "Asset", new { area = "Admin", id = @Model.Id })" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this asset?');">Delete</button>
            </form>

            <a asp-action="Index" asp-area="Admin" class="btn btn-secondary ms-2">
                <i class="fas fa-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body row">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <img src="@Model.ImagePath"
                         alt="Asset Image"
                         class="img-fluid rounded shadow-sm"
                         onerror="this.src='/images/no-image.png'; this.onerror=null;" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center"
                         style="width:100%;height:200px;border:1px solid #ddd;">
                        <i class="fas fa-image fa-3x text-muted"></i>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <dl class="row">
                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@Model.Address</dd>

                    <dt class="col-sm-4">Plot Number</dt>
                    <dd class="col-sm-8">@Model.PlotNumber</dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">@Model.Price.ToString("N2")</dd>

                    <dt class="col-sm-4">Block</dt>
                    <dd class="col-sm-8">@Model.Block?.Description</dd>

                    <dt class="col-sm-4">Property Type</dt>
                    <dd class="col-sm-8">@Model.PropertyType?.Description</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">@Model.Status?.Description</dd>

                    <dt class="col-sm-4">Date Uploaded</dt>
                    <dd class="col-sm-8">@Model.DateUploaded.ToString("dd MMM yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
