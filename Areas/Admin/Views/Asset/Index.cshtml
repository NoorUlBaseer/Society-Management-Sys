@model List<SocietyMng.Data.Entities.Asset>
@{
    ViewData["Title"] = "Assets List";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Assets Management</h1>
                <a href="@Url.Action("Create", "Asset", new { area = "Admin" })" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Add New Asset
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">All Assets (@Model.Count)</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Image</th>
                                        <th>Description</th>
                                        <th>Address</th>
                                        <th>Plot Number</th>
                                        <th>Price</th>
                                        <th>Block</th>
                                        <th>Property Type</th>
                                        <th>Status</th>
                                        <th>Date Added</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var asset in Model)
                                    {
                                        <tr>
                                            <td>
                                                @if (!string.IsNullOrEmpty(asset.ImagePath))
                                                {
                                                    <img src="@asset.ImagePath"
                                                         alt="Asset Image"
                                                         class="img-thumbnail"
                                                         style="width: 80px; height: 60px; object-fit: cover;"
                                                         onerror="this.src='/images/no-image.png'; this.onerror=null;" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                                         style="width: 80px; height: 60px; border: 1px solid #ddd;">
                                                        <i class="fas fa-image text-muted"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "Asset", new { area = "Admin", id = asset.Id })"
                                                   class="fw-bold text-decoration-none text-primary"
                                                   title="View Asset Details">
                                                    @asset.Description
                                                </a>
                                            </td>

                                            <td>
                                                <small>@asset.Address</small>
                                            </td>
                                            <td>@asset.PlotNumber</td>
                                            <td>
                                                <span class="fw-bold text-success">
                                                    @asset.Price.ToString("C")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@asset.Block?.Description</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@asset.PropertyType?.Description</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-success">@asset.Status?.Description</span>
                                            </td>
                                            <td>
                                                <small>@asset.DateUploaded.ToString("dd/MM/yyyy")</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-home fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No Assets Available</h4>
                            <p class="text-muted">Start by adding your first asset to the system.</p>
                            <a href="@Url.Action("Create", "Asset", new { area = "Admin" })" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Add First Asset
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="assetModal" tabindex="-1" aria-labelledby="assetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assetModalLabel">Asset Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="assetModalBody">
              
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                function viewAsset(assetId) {
            window.location.href = '@Url.Action("Details", "Asset", new { area = "Admin" })' + '/' + assetId;
        }


        function editAsset(assetId) {
            // Implement edit functionality
            window.location.href = '@Url.Action("Edit", "Asset", new { area = "Admin" })' + '/' + assetId;
        }

        function deleteAsset(assetId, description) {
            if (confirm('Are you sure you want to delete the asset "' + description + '"?')) {
                // Implement delete functionality
                console.log('Delete asset:', assetId);
            }
        }

        // Debug: Log image errors
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('img[src*="Data/Uploads"]');
            images.forEach(img => {
                img.addEventListener('error', function() {
                    console.error('Failed to load image:', this.src);
                });
                img.addEventListener('load', function() {
                    console.log('Successfully loaded image:', this.src);
                });
            });
        });
    </script>
}

<style>
    .table img {
        border-radius: 4px;
    }

    .btn-group .btn {
        margin-right: 2px;
    }

    .badge {
        font-size: 0.75em;
    }
</style>