@model List<SocietyMng.Data.Entities.Asset>
@{
    ViewData["Title"] = "Assets List";
    Layout = "_AdminLayout";
}
<h1 class="mt-4">Manage Assets</h1>
<div class="poppins-font">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

</div>
<div class="container d-flex justify-content-end poppins-font">
    <div class="mt-4 mb-2 me-5">
        <a href="@Url.Action("Create", "Asset", new { area = "Admin" })"
           class="btn"
           style="background-color: #ffffff; color: #6f42c1; border-radius: 0.5rem; font-weight: 600;">
            <i class="fas fa-plus me-1"></i> Add Listing
        </a>
    </div>
</div>

<div class="container d-flex justify-content-center poppins-font">

    <div class="table-responsive m-4 p-5 rounded-5" style="max-width: 1200px; width: 100%; background-color: #ffffff;">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="m-0 text-black">All Assets (@Model.Count)</h2>
        </div>
        <div class="mb-3 d-flex justify-content-end">
            <div class="d-flex align-items-center gap-3 flex-wrap p-2 rounded" style="background-color: #f9f9f9; color: black;">
                <div id="customSearchWrapper" class="d-flex align-items-center"></div>

                <div class="d-flex align-items-center px-2">
                    <label class="me-2 fw-bold text-black-50 m-0" for="sortSelect">Sort by:</label>
                    <select id="sortSelect" class="form-select form-select-sm border-0 px-5 bg-transparent" style="width: auto; box-shadow: none;">
                        <option value="">None</option>
                        <option value="1-asc">Address ↑</option>
                        <option value="1-desc">Address ↓</option>
                        <option value="2-asc">Price ↑</option>
                        <option value="2-desc">Price ↓</option>
                        <option value="5-asc">Date Added ↑</option>
                        <option value="5-desc">Date Added ↓</option>
                    </select>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="fw-bold text-black-50 m-0" for="propertyTypeFilter">Filter by:</label>
                    <select id="propertyTypeFilter" class="form-select form-select-sm border-0 px-5 bg-transparent" style="width: auto; box-shadow: none;">
                        <option value="">All</option>
                        <option value="Apartment">Apartment</option>
                        <option value="Commercial">Commercial</option>
                        <option value="Land/Plot">Land / Plot</option>
                    </select>
                </div>

            </div>
        </div>

        @if (Model.Any())
        {
            <table id="assetTable" class="table w-100">
                <thead class="bg-white">
                    <tr class="text-center">
                        <th class="fw-normal text-secondary px-3 py-2">#</th>
                        <th class="fw-normal text-start text-secondary px-3 py-2">Address</th>
                        <th class="fw-normal text-secondary px-3 py-2">Price</th>
                        <th class="fw-normal text-secondary px-3 py-2">Property Type</th>
                        <th class="fw-normal text-secondary px-3 py-2">Status</th>
                        <th class="fw-normal text-secondary px-3 py-2">Date Added</th>
                        <th class="fw-normal text-secondary px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int counter = 1;
                    }
                    @foreach (var asset in Model)
                    {
                        <tr class="text-center asset-row"
                            data-id="@asset.Id"
                            data-description="@asset.Description"
                            data-address="@asset.Address"
                            data-plot="@asset.PlotNumber"
                            data-price="@asset.Price.ToString("C")"
                            data-block="@asset.Block?.Description"
                            data-type="@asset.PropertyType?.Description"
                            data-status="@asset.Status?.Description"
                            data-date="@asset.DateUploaded.ToString("dd/MM/yyyy")"
                            data-image="@asset.ImagePath">
                            <td>@counter</td>
                            <td class="text-start">
                                <small>
                                    @(asset.Address ?? "") - Plot #: @(asset.PlotNumber ?? "") - @(asset.Block?.Description ?? "")
                                </small>
                            </td>
                            <td data-order="@asset.Price">
                                <span class="fw-bold text-success">
                                    Rs. @asset.Price.ToString("N2")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@asset.PropertyType?.Description</span>
                            </td>
                            <td>
                                <span class="badge bg-success">@asset.Status?.Description</span>
                            </td>
                            <td data-order="@asset.DateUploaded.Ticks">
                                <small>@asset.DateUploaded.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <button type="button" onclick="test()"
                                        class="btn open-delete-modal border-0 bg-transparent p-0"
                                        data-asset-id="@asset.Id"
                                        style="width: 24px; height: 24px; outline: none; box-shadow: none;">
                                    <img src="~/images/delete.png" alt="Delete" style="width: 100%; height: 100%; cursor: pointer;" />
                                </button>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-home fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No Assets Available</h4>
                <p class="text-muted">Start by adding your first asset to the system.</p>
                <a href="@Url.Action("Create", "Asset", new { area = "Admin" })" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Add First Asset
                </a>
            </div>
        }
    </div>

</div>


<div class="modal fade" id="assetModal" tabindex="-1" aria-labelledby="assetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white" style="border-radius: 5rem;border: 3px solid #ffffff;">
            <div class="modal-body px-5 py-5">
                <div class="row g-5">
                    <div class="col-md-5 text-center d-flex align-items-center justify-content-center">
                        <img id="modalAssetImage"
                             src=""
                             alt="Asset Image"
                             class="img-fluid rounded-4 shadow"
                             style="max-height: 300px; width: 100%; object-fit: cover;border: 1.5px solid #ffffff;" />
                    </div>

                    <div class="col-md-7">
                        <p><span class="modal-label">ID:</span> <span id="modalAssetId"></span></p>
                        <p><span class="modal-label">Description:</span> <span id="modalAssetDescription"></span></p>
                        <p><span class="modal-label">Address:</span> <span id="modalAssetAddress"></span></p>
                        <p><span class="modal-label">Plot No.:</span> <span id="modalAssetPlot"></span></p>
                        <p><span class="modal-label">Price: Rs. </span> <span id="modalAssetPrice"></span></p>
                        <p><span class="modal-label">Block:</span> <span id="modalAssetBlock"></span></p>
                        <p><span class="modal-label">Type:</span> <span id="modalAssetType"></span></p>
                        <p><span class="modal-label">Status:</span> <span id="modalAssetStatus"></span></p>
                        <p><span class="modal-label">Date Uploaded:</span> <span id="modalAssetDate"></span></p>

                        <div class="d-flex justify-content-end mt-4 gap-2">
                            @using (Html.BeginForm("Delete", "Asset", new { area = "Admin" }, FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", null, new { id = "modalDeleteAssetId" })
                                <button type="button" class="btn text-white px-4" style="background-color: #A11313;" id="confirmAssetDeleteBtn">
                                    Delete
                                </button>
                            }
                            <button type="button" class="btn text-white px-4" style="background-color: chocolate;" id="confirmAssetEditBtn">
                                Edit
                            </button>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="deleteAssetConfirmModal" tabindex="-1" aria-labelledby="deleteAssetConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header p-5">
                <h5 class="modal-title" id="deleteAssetConfirmModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-5">
                Are you sure you want to delete this asset?
            </div>
            <div class="modal-footer p-5">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="deleteAsset()" id="deleteAssetConfirmBtn">Yes, Delete</button>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable with proper configuration
            var table = $('#assetTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                columnDefs: [
                    {
                        orderable: false,
                        targets: [0, 6] // # column and Actions column
                    },
                    {
                        // Price column - extract numeric value from data-order attribute
                        targets: 2,
                        type: 'num'
                    },
                    {
                        // Date column - use data-order attribute (ticks) for sorting
                        targets: 5,
                        type: 'num'
                    }
                ],
                info: true,
                lengthChange: false,
                pageLength: 10,
                language: {
                    emptyTable: "No assets found",
                    paginate: {
                        previous: "<",
                        next: ">"
                    },
                    search: "",
                    searchPlaceholder: "Search assets..."
                },
                // Custom sorting for data-order attributes
                createdRow: function(row, data, dataIndex) {
                    // Price column
                    var priceCell = $(row).find('td:eq(2)');
                    var priceValue = priceCell.attr('data-order');
                    if (priceValue) {
                        priceCell.attr('data-sort', parseFloat(priceValue));
                    }

                    // Date column
                    var dateCell = $(row).find('td:eq(5)');
                    var dateValue = dateCell.attr('data-order');
                    if (dateValue) {
                        dateCell.attr('data-sort', parseInt(dateValue));
                    }
                }
            });

            // Custom sorting implementation
            $('#sortSelect').on('change', function () {
                const val = $(this).val();
                if (!val) {
                    // Clear all sorting
                    table.order([]).draw();
                    return;
                }

                const [colIndex, dir] = val.split('-');
                table.order([parseInt(colIndex), dir]).draw();
            });

            // Move search box to custom wrapper
            let searchBox = $('#assetTable_filter input');
            let searchLabel = $('#assetTable_filter label');
            let searchWrapper = $('#customSearchWrapper');

            searchBox.addClass('form-control form-control-sm bg-light text-dark border-0');
            searchBox.wrap('<div class="input-group"></div>');
            searchBox.before('<span class="input-group-text bg-white"><i class="bi bi-search"></i></span>');

            searchWrapper.append(searchBox.closest('.input-group'));
            searchLabel.remove();

            // Property type filter
            $('#propertyTypeFilter').on('change', function () {
                var selected = $(this).val();

                if (selected === "") {
                    table.column(3).search('').draw();
                } else {
                    table.column(3).search(selected, false, false).draw();
                }
            });

            // Hide original DataTable elements
            $('#assetTable_filter').hide();
            $('#assetTable_paginate').appendTo('#assetTable_wrapper');
        });

        // Debug: Log image errors
        document.addEventListener('DOMContentLoaded', function() {
            const images = document.querySelectorAll('img[src*="Data/Uploads"]');
            images.forEach(img => {
                img.addEventListener('error', function() {
                    console.error('Failed to load image:', this.src);
                });
                img.addEventListener('load', function() {
                    console.log('Successfully loaded image:', this.src);
                });
            });
        });

        let deleteAssetForm;

        $(document).on('click', '.asset-row', function (e) {
            if (
                $(e.target).closest("form").length > 0 ||
                $(e.target).closest(".open-delete-modal").length > 0
            ) return;

            const assetRow = $(this);
            $('#modalAssetId').text(assetRow.data('id'));
            $('#modalAssetDescription').text(assetRow.data('description'));
            $('#modalAssetAddress').text(assetRow.data('address'));
            $('#modalAssetPlot').text(assetRow.data('plot'));
            $('#modalAssetPrice').text(assetRow.data('price'));
            $('#modalAssetBlock').text(assetRow.data('block'));
            $('#modalAssetType').text(assetRow.data('type'));
            $('#modalAssetStatus').text(assetRow.data('status'));
            $('#modalAssetDate').text(assetRow.data('date'));

            const imageUrl = assetRow.data('image');
            $('#modalAssetImage').attr('src', imageUrl || '/images/no-image.png');
            $('#modalDeleteAssetId').val(assetRow.data('id'));

            const assetModal = new bootstrap.Modal(document.getElementById('assetModal'));
            assetModal.show();
        });

        $('#confirmAssetDeleteBtn').on('click', function () {
            deleteAssetForm = $(this).closest('form');
            const confirmModal = new bootstrap.Modal(document.getElementById('deleteAssetConfirmModal'));
            confirmModal.show();
        });

        function deleteAsset(){
             if (deleteAssetForm) {
                deleteAssetForm.submit();
            }
        }

        $('#deleteAssetConfirmBtn').on('click', function () {
            if (deleteAssetForm) {
                deleteAssetForm.submit();
            }
        });

        $(document).on('click', '.open-delete-modal', function () {
            const assetId = $(this).data('asset-id');
            $('#modalDeleteAssetId').val(assetId);

            // Find the form inside the modal to submit
            deleteAssetForm = $('#modalDeleteAssetId').closest('form');

            const modal = new bootstrap.Modal(document.getElementById('deleteAssetConfirmModal'));
            modal.show();
        });

        $('#confirmAssetEditBtn').on('click', function () {
            const assetId = $('#modalAssetId').text();
            window.location.href = `/Admin/Asset/Edit/${assetId}`;
        });

    </script>
}

<style>
    .table img {
        border-radius: 4px;
    }

    .btn-group .btn {
        margin-right: 2px;
    }

    .badge {
        font-size: 0.75em;
    }
</style>