@model SocietyMng.Areas.Admin.DTOs.AssetCreateView
@{
    ViewData["Title"] = "Create Asset";
    Layout = "_AdminLayout";
}

<div class="container">
    <h1 class="mt-4">Create New Asset</h1>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Asset Information</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Create", "Asset", new { area = "Admin" }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "3", placeholder = "Enter asset description" })
                                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.Address, new { @class = "form-label" })
                                    @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = "3", placeholder = "Enter complete address" })
                                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.PlotNumber, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.PlotNumber, new { @class = "form-control", placeholder = "Enter plot number" })
                                    @Html.ValidationMessageFor(m => m.PlotNumber, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.Price, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01", min = "0", placeholder = "Enter price" })
                                    @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.BlockId, "Block", new { @class = "form-label" })
                                    @Html.DropDownListFor(m => m.BlockId,
                                    new SelectList(ViewBag.Blocks as List<SocietyMng.Data.Entities.SystemCodeItem>, "Id", "Description"),
                                                                "-- Select Block --",
                                                                new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.BlockId, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                @Html.LabelFor(m => m.PropertyTypeId, "Property Type", new { @class = "form-label" })
                                @Html.DropDownListFor(m => m.PropertyTypeId,
                                                                new SelectList(ViewBag.PropertyTypes as List<SocietyMng.Data.Entities.SystemCodeItem>, "Id", "Description"),
                                                                "-- Select Property Type --",
                                                                new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.PropertyTypeId, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                @Html.LabelFor(m => m.StatusId, "Status", new { @class = "form-label" })
                                @Html.DropDownListFor(m => m.StatusId,
                                                                new SelectList(ViewBag.Statuses as List<SocietyMng.Data.Entities.SystemCodeItem>, "Id", "Description"),
                                                                "-- Select Status --",
                                                                new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.StatusId, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group mb-3">
                                <label for="ImageFile" class="form-label">Asset Image <span class="text-danger">*</span></label>
                                <input type="file" id="ImageFile" name="ImageFile" class="form-control" accept="image/*" required />
                                @Html.ValidationMessage("ImageFile", "", new { @class = "text-danger" })
                                @{
                                        var maxFileSize = ViewBag.MaxFileSizeMB ?? 20; // Default to 20 if not set
                                    }
                                    <small class="form-text text-muted">Maximum file size: @maxFileSize MB. Supported formats: JPG, PNG, GIF</small>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <div class="d-flex justify-content-between">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save me-1"></i>Create Asset
                                </button>
                                <a href="@Url.Action("Index", "Asset", new { area = "Admin" })" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-1"></i>Back to Assets
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // File upload preview and validation
        document.getElementById('ImageFile').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const maxSizeMB = @(ViewBag.MaxFileSizeMB ?? 20); // Default to 20MB
                const maxSize = maxSizeMB * 1024 * 1024; // Convert MB to bytes

                if (file.size > maxSize) {
                    alert('File size exceeds the maximum allowed size of ' + maxSizeMB + ' MB');
                    this.value = '';
                    return;
                }

                // Show selected file name
                const fileName = file.name;
                console.log('Selected file:', fileName);
            }
        });

        // Form validation on submit
        document.querySelector('form').addEventListener('submit', function(e) {
            const requiredFields = ['Description', 'Address', 'PlotNumber', 'Price', 'BlockId', 'PropertyTypeId', 'StatusId'];
            let isValid = true;

            requiredFields.forEach(function(fieldName) {
                const field = document.querySelector('[name="' + fieldName + '"]');
                if (field && !field.value.trim()) {
                    isValid = false;
                    field.classList.add('is-invalid');
                } else if (field) {
                    field.classList.remove('is-invalid');
                }
            });

            if (!isValid) {
                e.preventDefault();
                alert('Please fill in all required fields.');
            }
        });
    </script>
}