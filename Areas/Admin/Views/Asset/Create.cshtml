@model SocietyMng.Areas.Admin.DTOs.AssetCreateView
@{
    ViewData["Title"] = "Create Asset";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(to bottom, #0f1d0f, #2d7330);
            color: white;
        }

        .container {
            display: flex;
            height: 100vh;
            align-items: center;
            justify-content: center;
        }

        .form-container {
            display: flex;
            width: 90%;
            max-width: 1200px;
            gap: 200px;
        }

        .left-form, .right-form {
            flex: 1;
        }

        .left-form {
            width: 700px;
        }

        .form-group {
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 20px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
            width: 100px;
        }

        input[type="text"],
        input[type="number"],
        textarea,
        select {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 25px;
            background-color: #D9D9D9;
            color: black;
            flex: 1;
        }

        textarea {
            height: 100px;
            border-radius: 25px;
        }

        .checkbox-group {
            display: flex;
            gap: 15px;
            align-items: center;
        }

            .checkbox-group label {
                display: flex;
                align-items: center;
                gap: 8px;
                font-weight: normal;
            }

            .checkbox-group input[type="checkbox"] {
                vertical-align: middle;
                margin: 0;
                position: relative;
                top: 0;
            }


        .file-upload-box {
            background: white;
            color: #000;
            border-radius: 5px;
            padding: 40px 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .file-upload-box input[type="file"] {
                display: none;
            }

        .custom-file-upload {
            padding: 10px 20px;
            background-color: #00e3d8;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin-top: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-left: auto;
            margin-right: auto;
        }

        .submit-btn {
            margin-top: 30px;
            width: 100px;
            background: linear-gradient(to right, #ffaa00, #ff8800);
            color: white;
            padding: 10px 30px;
            border: none;
            border-left: 2px solid white;
            border-bottom: 2px solid white;
            border-radius: 25px;
            font-size: 16px;
            float: right;
            cursor: pointer;
        }


        .alert {
            color: red;
        }

        /* Remove default checkbox appearance */
        input[type="radio"] {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            width: 18px;
            height: 18px;
            border: 2px solid white;
            border-radius: 4px;
            background-color: transparent;
            position: relative;
            cursor: pointer;
        }

            /* Checked state: white background */
            input[type="radio"]:checked {
                background-color: white;
            }

                /* Custom green checkmark */
                input[type="radio"]:checked::after {
                    content: '';
                    position: absolute;
                    top: 2px;
                    left: 5px;
                    width: 4px;
                    height: 10px;
                    border: solid green;
                    border-width: 0 2px 2px 0;
                    transform: rotate(45deg);
                }

    </style>
</head>
<body>
    <div class="container">
        @using (Html.BeginForm("Create", "Asset", new { area = "Admin" }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-container">
                <div class="left-form">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert">@ViewBag.ErrorMessage</div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert">
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="form-group">
                        @Html.LabelFor(m => m.BlockId, "Block")
                        @Html.DropDownListFor(m => m.BlockId, new SelectList(ViewBag.Blocks as List<SocietyMng.Data.Entities.SystemCodeItem>, "Id", "Description"), "-- Select Block --")
                        @Html.ValidationMessageFor(m => m.BlockId, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Address)
                        @Html.TextBoxFor(m => m.Address)
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Description)
                        @Html.TextAreaFor(m => m.Description)
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.PlotNumber)
                        @Html.TextBoxFor(m => m.PlotNumber)
                        @Html.ValidationMessageFor(m => m.PlotNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.PropertyTypeId, "Property Type")
                        @Html.DropDownListFor(m => m.PropertyTypeId, new SelectList(ViewBag.PropertyTypes as List<SocietyMng.Data.Entities.SystemCodeItem>, "Id", "Description"), "-- Select Property Type --")
                        @Html.ValidationMessageFor(m => m.PropertyTypeId, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label>Type</label>
                        <div class="checkbox-group">
                            <label>
                                <input type="radio" name="Type" value="Rent" checked /> Rent
                            </label>
                            <label>
                                <input type="radio" name="Type" value="Sell" /> Sell
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Price)
                        @Html.TextBoxFor(m => m.Price, new { type = "number", step = "0.01", min = "0" })
                        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="right-form">
                    <label>Photo</label>
                    <div class="file-upload-box">
                        <i class="bi bi-cloud-arrow-up-fill" style="font-size: 3rem;"></i>
                        <p>Drag and Drop here</p>
                        <p>or</p>
                        <img id="previewImage" alt="" style="max-width: 100%; max-height: 200px; margin-top: 15px; border-radius: 10px;" />

                        <label class="custom-file-upload">
                            Select file


                            <input type="file" id="ImageFile" name="ImageFile" accept="image/*" onchange="document.getElementById('previewImage').src = window.URL.createObjectURL(this.files[0])" />

                        </label>

                        @{
                            var maxFileSize = ViewBag.MaxFileSizeMB ?? 20;
                        }
                        <p style="font-size: 12px; margin-top: 10px;">Max size: @maxFileSize MB. JPG, PNG, GIF only</p>
                        @Html.ValidationMessage("ImageFile", "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="submit-btn">Add</button>
                </div>
            </div>
        }
    </div>
</body>
</html>
@section Scripts {
    <script>
        document.getElementById('ImageFile').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const maxSizeMB = @(ViewBag.MaxFileSizeMB ?? 20); // Default to 20MB
            const maxSize = maxSizeMB * 1024 * 1024; // Convert MB to bytes

            if (file) {
                if (file.size > maxSize) {
                    alert('File size exceeds the maximum allowed size of ' + maxSizeMB + ' MB');
                    this.value = '';
                    return;
                }

                // Show selected file name in console (optional)
                console.log('Selected file:', file.name);
            }
        })
        // Form validation on submit
        document.querySelector('form').addEventListener('submit', function(e) {
            const requiredFields = ['Description', 'Address', 'PlotNumber', 'Price', 'BlockId', 'PropertyTypeId'];
            let isValid = true;

            requiredFields.forEach(function(fieldName) {
                const field = document.querySelector('[name="' + fieldName + '"]');
                if (field && !field.value.trim()) {
                    isValid = false;
                    field.classList.add('is-invalid');
                } else if (field) {
                    field.classList.remove('is-invalid');
                }
            });

            if (!isValid) {
                e.preventDefault();
                alert('Please fill in all required fields.');
            }
        });

    </script>
}
