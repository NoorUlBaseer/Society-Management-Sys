@model SocietyMng.Areas.Admin.ModelView.AssetCreateView
@{
    ViewData["Title"] = "Create Asset";
    Layout = "_AdminLayout";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(to bottom, #0f1d0f, #2d7330);
            color: white;
        }

        .container {
            display: flex;
            height: 100vh;
            align-items: center;
            justify-content: center;
        }

        .form-container {
            display: flex;
            width: 90%;
            max-width: 1200px;
            gap: 200px;
        }

        .left-form, .right-form {
            flex: 1;
        }

        .left-form {
            width: 700px;
        }

        .form-group {
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 20px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 500;
            width: 100px;
        }

        .description-group {
            margin-bottom: 35px;
        }

        .description-error {
            position: absolute;
            bottom: -18px;
            left: 0;
            font-size: 12px;
            color: #dc3545;
        }

        input[type="text"],
        input[type="number"],
        textarea,
        select {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 25px;
            background-color: #D9D9D9;
            color: black;
            flex: 1;
        }

            input.is-invalid,
            textarea.is-invalid,
            select.is-invalid {
                border: 2px solid #dc3545;
                background-color: #f8d7da;
            }

        textarea {
            height: 100px;
            border-radius: 25px;
        }


        .file-upload-box {
            background: white;
            color: #000;
            border-radius: 5px;
            padding: 40px 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

            .file-upload-box input[type="file"] {
                display: none;
            }

        .custom-file-upload {
            padding: 10px 20px;
            background-color: #00e3d8;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            margin-top: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin-left: auto;
            margin-right: auto;
        }

        .submit-btn {
            margin-top: 30px;
            width: 100px;
            background: linear-gradient(to right, #ffaa00, #ff8800);
            color: white;
            padding: 10px 30px;
            border: none;
            border-left: 2px solid white;
            border-bottom: 2px solid white;
            border-radius: 25px;
            font-size: 16px;
            float: right;
            cursor: pointer;
        }

        .alert {
            color: red;
            background-color: rgba(220, 53, 69, 0.1);
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .validation-error {
            color: #dc3545;
            font-size: 12px;
            margin-top: 5px;
        }

        input[type="radio"] {
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            width: 18px;
            height: 18px;
            border: 2px solid white;
            border-radius: 4px;
            background-color: transparent;
            position: relative;
            cursor: pointer;
        }

            /* Checked state: white background */
            input[type="radio"]:checked {
                background-color: white;
            }

                /* Custom green checkmark */
                input[type="radio"]:checked::after {
                    content: '';
                    position: absolute;
                    top: 2px;
                    left: 5px;
                    width: 4px;
                    height: 10px;
                    border: solid green;
                    border-width: 0 2px 2px 0;
                    transform: rotate(45deg);
                }


    </style>
</head>
<body>
    <h1 class="mt-4">Create New Asset</h1>
    <div class="container">
        @using (Html.BeginForm("Create", "Asset", new { area = "Admin" }, FormMethod.Post, true, new { enctype = "multipart/form-data", id = "assetForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-container">
                <div class="left-form">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert">@ViewBag.ErrorMessage</div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert">
                            <ul>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="form-group">
                        @Html.LabelFor(m => m.BlockId, "Block")
                        @Html.DropDownListFor(m => m.BlockId, new SelectList(ViewBag.Blocks as List<SocietyMng.Data.Entities.SystemCodeItem>, "Id", "Description", Model?.BlockId), "-- Select Block --", new { id = "BlockId" })
                        @Html.ValidationMessageFor(m => m.BlockId, "", new { @class = "validation-error" })
                        <div class="validation-error" id="BlockId-error" style="display: none;"></div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Address)
                        @Html.TextBoxFor(m => m.Address, new { id = "Address", placeholder = "e.g., Block-A/123, Street-5/456", value = Model?.Address })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "validation-error" })
                        <div class="validation-error" id="Address-error" style="display: none;"></div>
                    </div>

                    <div class="form-group description-group">
                        @Html.LabelFor(m => m.Description)
                        @Html.TextAreaFor(m => m.Description, new {
                        id = "Description",
                                        placeholder = "Description must start with alphabets",
                                        @value = Model?.Description
                                        })
                                       
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "validation-error" })
                    <div class="validation-error" id="Description-error" style="display: none;"></div>
                </div>


                    <div class="form-group">
                        @Html.LabelFor(m => m.PlotNumber)
                        @Html.TextBoxFor(m => m.PlotNumber, new { id = "PlotNumber", placeholder = "Enter digits only (e.g., 123)", value = Model?.PlotNumber })
                        @Html.ValidationMessageFor(m => m.PlotNumber, "", new { @class = "validation-error" })
                        <div class="validation-error" id="PlotNumber-error" style="display: none;"></div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.PropertyTypeId, "Property Type")
                        @Html.DropDownListFor(m => m.PropertyTypeId, new SelectList(ViewBag.PropertyTypes as List<SocietyMng.Data.Entities.SystemCodeItem>, "Id", "Description", Model?.PropertyTypeId), "-- Select Property Type --", new { id = "PropertyTypeId" })
                        @Html.ValidationMessageFor(m => m.PropertyTypeId, "", new { @class = "validation-error" })
                        <div class="validation-error" id="PropertyTypeId-error" style="display: none;"></div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Price)
                        @Html.TextBoxFor(m => m.Price, new { type = "number", step = "1", min = "10000", max = "100000000", id = "Price", placeholder = "10,000 - 100,000,000", value = Model?.Price })
                        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "validation-error" })
                        <div class="validation-error" id="Price-error" style="display: none;"></div>
                    </div>
                </div>

                <div class="right-form">
                    <label>Photo</label>
                    <div class="file-upload-box">
                        <i class="bi bi-cloud-arrow-up-fill" style="font-size: 3rem;"></i>
                        <p>Drag and Drop here</p>
                        <p>or</p>
                        <img id="previewImage" alt="" style="max-width: 100%; max-height: 200px; margin-top: 15px; border-radius: 10px;" />

                        <label class="custom-file-upload">
                            Select file
                            <input type="file" id="ImageFile" name="ImageFile" accept="image/*" onchange="previewImageFile(this)" />
                        </label>

                        @{
                            var maxFileSize = ViewBag.MaxFileSizeMB ?? 20;
                        }
                        <p style="font-size: 12px; margin-top: 10px;">Max size: @maxFileSize MB. JPG, PNG, GIF only</p>
                        @Html.ValidationMessage("ImageFile", "", new { @class = "validation-error" })
                        <div class="validation-error" id="ImageFile-error" style="display: none;"></div>
                    </div>

                    <button type="submit" class="submit-btn">Add</button>
                </div>
            </div>
        }
    </div>

    <script>
        // Validation patterns
        const validationRules = {
            Description: {
                pattern: /^[A-Za-z][A-Za-z0-9\s\-\/.,]*$/,
                message: "Invalid Description ."
            },
            Address: {
                pattern: /^[A-Za-z][A-Za-z0-9\s\-\/]*$/,
                message: "invalid Address "
            },
            PlotNumber: {
                pattern: /^\d+$/,
                message: "Plot number must contain only digits."
            },
            Price: {
                min: 10000,
                max: 100000000,
                message: "Price must be between 10,000 and 100,000,000."
            }
        };

        function previewImageFile(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const maxSizeMB = @(ViewBag.MaxFileSizeMB ?? 20);
                const maxSize = maxSizeMB * 1024 * 1024;

                // Check file size
                if (file.size > maxSize) {
                    showError('ImageFile', 'File size exceeds the maximum allowed size of ' + maxSizeMB + ' MB');
                    input.value = '';
                    return;
                } else {
                    hideError('ImageFile');
                }

                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('previewImage').src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        }

        function showError(fieldId, message) {
            const field = document.getElementById(fieldId);
            const errorDiv = document.getElementById(fieldId + '-error');

            if (field) {
                field.classList.add('is-invalid');
            }
            if (errorDiv) {
                errorDiv.textContent = message;
                errorDiv.style.display = 'block';
            }
        }

        function hideError(fieldId) {
            const field = document.getElementById(fieldId);
            const errorDiv = document.getElementById(fieldId + '-error');

            if (field) {
                field.classList.remove('is-invalid');
            }
            if (errorDiv) {
                errorDiv.style.display = 'none';
            }
        }

        function validateField(fieldId) {
            const field = document.getElementById(fieldId);
            const value = field.value.trim();
            const rule = validationRules[fieldId];

            if (!value) {
                showError(fieldId, fieldId + ' is required.');
                return false;
            }

            if (rule) {
                if (rule.pattern && !rule.pattern.test(value)) {
                    showError(fieldId, rule.message);
                    return false;
                }

                if (fieldId === 'Price') {
                    const numValue = parseFloat(value);
                    if (numValue < rule.min || numValue > rule.max) {
                        showError(fieldId, rule.message);
                        return false;
                    }
                }
            }

            hideError(fieldId);
            return true;
        }

        function validateDropdown(fieldId) {
            const field = document.getElementById(fieldId);
            const value = field.value;

            if (!value || value === '') {
                showError(fieldId, 'Please select a ' + fieldId.replace('Id', '').toLowerCase() + '.');
                return false;
            }

            hideError(fieldId);
            return true;
        }

        function validateImageFile() {
            const field = document.getElementById('ImageFile');

            if (!field.files || field.files.length === 0) {
                showError('ImageFile', 'Please select an image file.');
                return false;
            }

            hideError('ImageFile');
            return true;
        }

        // Real-time validation
        document.addEventListener('DOMContentLoaded', function() {
            // Text field validations
            ['Description', 'Address', 'PlotNumber', 'Price'].forEach(function(fieldId) {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('blur', function() {
                        validateField(fieldId);
                    });

                    field.addEventListener('input', function() {
                        if (field.classList.contains('is-invalid')) {
                            validateField(fieldId);
                        }
                    });
                }
            });

            // Dropdown validations
            ['BlockId', 'PropertyTypeId'].forEach(function(fieldId) {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('change', function() {
                        validateDropdown(fieldId);
                    });
                }
            });

            // Plot number - only digits
            const plotField = document.getElementById('PlotNumber');
            if (plotField) {
                plotField.addEventListener('input', function(e) {
                    // Remove any non-digit characters
                    this.value = this.value.replace(/[^0-9]/g, '');
                });
            }

            // Price field - format number
            const priceField = document.getElementById('Price');
            if (priceField) {
                priceField.addEventListener('input', function(e) {
                    // Ensure only numbers
                    let value = this.value.replace(/[^0-9]/g, '');
                    if (value.length > 0) {
                        this.value = value;
                    }
                });
            }
        });

        // Form submission validation
        document.getElementById('assetForm').addEventListener('submit', function(e) {
            let isValid = true;

            // Validate all fields
            const fieldsToValidate = ['Description', 'Address', 'PlotNumber', 'Price'];
            fieldsToValidate.forEach(function(fieldId) {
                if (!validateField(fieldId)) {
                    isValid = false;
                }
            });

            const dropdownsToValidate = ['BlockId', 'PropertyTypeId'];
            dropdownsToValidate.forEach(function(fieldId) {
                if (!validateDropdown(fieldId)) {
                    isValid = false;
                }
            });

            if (!validateImageFile()) {
                isValid = false;
            }

            if (!isValid) {
                e.preventDefault();
                alert('Please correct the validation errors before submitting.');

                // Scroll to first error
                const firstError = document.querySelector('.is-invalid');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    firstError.focus();
                }
            }
        });
    </script>
</body>
</html>