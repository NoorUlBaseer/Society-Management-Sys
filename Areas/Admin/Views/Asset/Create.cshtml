@model SocietyMng.Areas.Admin.DTOs.AssetCreateView

@{
    ViewData["Title"] = "Create Asset";
    Layout = "_AdminLayout";
}

<div class="container">
    <h1>@ViewData["Title"]</h1>

    <!-- Success/Error Messages -->
    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <!-- Left Column -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Address" class="control-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PlotNumber" class="control-label"></label>
                    <input asp-for="PlotNumber" class="form-control" />
                    <span asp-validation-for="PlotNumber" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="BlockId" class="control-label">Block</label>
                    <select asp-for="BlockId" class="form-control">
                        <option value="">-- Select Block --</option>
                        @foreach (var block in (List<SocietyMng.Data.Entities.SystemCodeItem>)ViewBag.Blocks)
                        {
                            <option value="@block.Id">@block.Description</option>
                        }
                    </select>
                    <span asp-validation-for="BlockId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PropertyTypeId" class="control-label">Property Type</label>
                    <select asp-for="PropertyTypeId" class="form-control">
                        <option value="">-- Select Property Type --</option>
                        @foreach (var propertyType in (List<SocietyMng.Data.Entities.SystemCodeItem>)ViewBag.PropertyTypes)
                        {
                            <option value="@propertyType.Id">@propertyType.Description</option>
                        }
                    </select>
                    <span asp-validation-for="PropertyTypeId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="StatusId" class="control-label">Status</label>
                    <select asp-for="StatusId" class="form-control">
                        <option value="">-- Select Status --</option>
                        @foreach (var status in (List<SocietyMng.Data.Entities.SystemCodeItem>)ViewBag.Statuses)
                        {
                            <option value="@status.Id">@status.Description</option>
                        }
                    </select>
                    <span asp-validation-for="StatusId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label for="ImageFile" class="control-label">Upload Image</label>
                    <input name="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png">
                    <small class="form-text text-muted">
                        Allowed formats: JPG, JPEG, PNG. Max size: @(ViewBag.MaxFileSizeMB)MB
                    </small>
                </div>
            </div>
        </div>

        <div class="form-group mt-4">
            <button type="submit" class="btn btn-primary">Create Asset</button>
            <a asp-action="Index" asp-controller="Asset" asp-area="Admin" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}