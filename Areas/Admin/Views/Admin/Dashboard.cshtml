@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="container">
    <h1 class="mt-4">Admin Dashboard</h1>

    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Users</h5>
                    <p class="card-text">Manage system users</p>
                    <a href="@Url.Action("ManageUsers")" class="btn btn-light">Go to Users</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Create Asset</h5>
                    <p class="card-text">Add new property</p>
                    <a href="@Url.Action("CreateAsset")" class="btn btn-light">Create Asset</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Complaints</h5>
                    <p class="card-text">View and resolve complaints</p>
                    <a href="@Url.Action("ManageComplaints")" class="btn btn-light">Go to Complaints</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Assets</h5>
                    <p class="card-text">Manage properties/assets</p>
                    <a href="@Url.Action("ManageAssets")" class="btn btn-light">Asset Listing</a>
                </div>
            </div>
        </div>
    </div>
</div>