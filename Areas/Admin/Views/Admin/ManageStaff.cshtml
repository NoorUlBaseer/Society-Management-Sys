@* @model List<SocietyMng.Data.Entities.Staff>
@{
    ViewData["Title"] = "Manage Staff";
    Layout = "_AdminLayout";
}

<div class="container">
    <h1 class="mt-4">Manage Staff</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="table-responsive mt-4">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Position</th>
                    <th>Salary</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model)
                {
                    <tr>
                        <td>@staff.FullName</td>
                        <td>@staff.Email</td>
                        <td>@staff.Position</td>
                        <td>
                            @using (Html.BeginForm("UpdateSalary", "Admin", new { area = "Admin" }, FormMethod.Post))
                            {
                                @Html.Hidden("staffId", staff.Id)
                                <div class="input-group">
                                    <input type="number" name="NewSalary" class="form-control form-control-sm" value="@staff.Salary" step="10.0" min="0" />
                                    <div class="input-group-append">
                                        <button type="submit" class="btn btn-sm btn-primary">Update</button>
                                    </div>
                                </div>
                            }
                        </td>
                        <td>@(staff.IsActive ? "Active" : "Inactive")</td>
                        <td>
                            @using (Html.BeginForm("ToggleStaffStatus", "Admin", new { area = "Admin" }, FormMethod.Post))
                            {
                                @Html.Hidden("staffId", staff.Id)
                                <button type="submit" class="btn btn-sm @(staff.IsActive ? "btn-warning" : "btn-success")">
                                    @(staff.IsActive ? "Deactivate" : "Activate")
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div> *@