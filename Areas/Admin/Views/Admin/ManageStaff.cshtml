@model List<SocietyMng.Data.Entities.Staff>

<h2>Staff Management</h2>
<a asp-area="Admin" asp-controller="Admin" asp-action="AddStaff" class="btn btn-primary mb-3">Add New Staff</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Position</th>
            <th>Salary</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var staff in Model)
        {
            <tr>
                <td>@staff.FullName</td>
                <td>@staff.Email</td>
                <td>@staff.Position</td>
                <td>@staff.Salary.ToString("C")</td>
                <td>
                    <span class="badge @(staff.IsActive ? "bg-success" : "bg-danger")">
                        @(staff.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#salaryModal"
                            data-staff-id="@staff.Id"
                            data-staff-name="@staff.FullName"
                            data-position="@staff.Position"
                            data-current-salary="@staff.Salary">
                        Update Salary
                    </button>
                    <form asp-area="Admin" asp-controller="Admin" asp-action="ToggleStaffStatus" method="post" class="d-inline">
                        <input type="hidden" name="staffId" value="@staff.Id" />
                        <button type="submit" class="btn btn-sm @(staff.IsActive ? "btn-warning" : "btn-success")">
                            @(staff.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Salary Update Modal -->
<div class="modal fade" id="salaryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Salary</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="Admin" asp-controller="Admin" asp-action="UpdateSalary" method="post">
                <div class="modal-body">
                    <input type="hidden" name="StaffId" id="staffId" />
                    <input type="hidden" name="StaffName" id="staffName" />
                    <input type="hidden" name="Position" id="position" />

                    <div class="mb-3">
                        <label class="form-label">Staff Member</label>
                        <input type="text" class="form-control" id="displayName" readonly>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Current Salary</label>
                        <input type="text" class="form-control" id="currentSalary" readonly>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">New Salary</label>
                        <input type="number" step="0.01" name="NewSalary" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reason for Change</label>
                        <textarea name="Reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Salary</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var salaryModal = document.getElementById('salaryModal');
            salaryModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;

                document.getElementById('staffId').value = button.getAttribute('data-staff-id');
                document.getElementById('staffName').value = button.getAttribute('data-staff-name');
                document.getElementById('position').value = button.getAttribute('data-position');

                document.getElementById('displayName').value = button.getAttribute('data-staff-name') +
                    ' (' + button.getAttribute('data-position') + ')';

                document.getElementById('currentSalary').value = '$' +
                    parseFloat(button.getAttribute('data-current-salary')).toFixed(2);
            });
        });
    </script>
}