@model List<SocietyMng.Data.Entities.User>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "_AdminLayout";
}

<div class="container">
    <h1 class="mt-4">Manage Users</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="table-responsive mt-4">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Role?.Description</td>
                        <td>@(user.IsActive ? "Active" : "Blocked")</td>
                        <td>@user.CreatedAt.ToString("d")</td>
                        <td>
                            @using (Html.BeginForm("ToggleUserStatus", "Admin", new { area = "Admin" }, FormMethod.Post))
                            {
                                @Html.Hidden("userId", user.Id)
                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-warning" : "btn-success")">
                                    @(user.IsActive ? "Block" : "Unblock")
                                </button>
                            }

                            @using (Html.BeginForm("DeleteUser", "Admin", new { area = "Admin" }, FormMethod.Post))
                            {
                                @Html.Hidden("userId", user.Id)
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete user @user.FullName?');">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>