@model List<SocietyMng.Data.Entities.User>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "_AdminLayout";
}
<h1 class="mt-4">Manage Users</h1>

<div class="poppins-font">

    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }


        <div class="container d-flex justify-content-center">
            <div class="table-responsive m-4 p-5 rounded-5" style="max-width: 900px; width: 100%; background-color: #ffffff; color: black;">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="m-0 text-black">All Users</h2>
                    <!-- DataTables will auto-place its search input here -->
                </div>
                <div class="mb-3 d-flex justify-content-end">
                    <div class="d-flex align-items-center gap-3 flex-wrap p-2 rounded" style="background-color: #f9f9f9;">
                        <div id="customSearchWrapper" class="d-flex align-items-center"></div>

                        <div class="d-flex align-items-center px-2">
                            <label class="me-2 fw-bold text-black-50 m-0" for="sortSelect">Sort by:</label>
                            <select id="sortSelect" class="form-select form-select-sm border-0 px-5 bg-transparent" style="width: auto; box-shadow: none;">
                                <option value="">None</option>
                                <option value="0-asc">ID ↑</option>
                                <option value="0-desc">ID ↓</option>
                                <option value="1-asc">Name ↑</option>
                                <option value="1-desc">Name ↓</option>
                                <option value="2-asc">Email ↑</option>
                                <option value="2-desc">Email ↓</option>
                                <option value="3-asc">Role ↑</option>
                                <option value="3-desc">Role ↓</option>
                                <option value="4-asc">Created ↑</option>
                                <option value="4-desc">Created ↓</option>
                            </select>
                        </div>
                    </div>
                </div>




                <table id="userTable" class="table w-100">
                    <thead class="bg-white">
                        <tr class="text-center" style="text-align: center !important;">
                            <th class="fw-normal text-secondary rounded-top-start px-3 py-2">#</th>
                            <th class="fw-normal text-secondary px-3 py-2">Name</th>
                            <th class="fw-normal text-secondary px-3 py-2">Email</th>
                            <th class="fw-normal text-secondary px-3 py-2">Role</th>
                            <th class="fw-normal text-secondary px-3 py-2">Created</th>
                            <th class="fw-normal text-secondary rounded-top-end px-3 py-2">Status</th>
                            <th class="fw-normal text-secondary px-3 py-2"></th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int counter = 1; // Initialize counter
                        }
                        @foreach (var user in Model)
                        {
                            <tr class="text-center user-row" style="cursor: pointer;"
                                data-phone="@user.PhoneNumber"
                                data-gender="@user.Gender"
                                data-status="@(user.IsActive ? "Active" : "Blocked")">
                                <td class="px-3 py-2">@counter</td> <!-- Display counter instead of user.Id -->
                                <td class="px-3 py-2">@user.FullName</td>
                                <td class="px-3 py-2">@user.Email</td>
                                <td class="px-3 py-2">@user.Role?.Description</td>
                                <td class="px-3 py-2">@user.CreatedAt.ToString("d")</td>
                                <td class="px-3 py-2">
                                    <div class="d-flex gap-2 justify-content-center">
                                        @using (Html.BeginForm("ToggleUserStatus", "Admin", new { area = "Admin" }, FormMethod.Post))
                                        {
                                            @Html.Hidden("userId", user.Id)
                                            <button type="submit"
                                                    class="btn btn-sm fw-bold"
                                                    style="min-width: 80px;
                                        background-color: @(user.IsActive ? "#ffe5e5" : "#e6ffed");
                                        color: @(user.IsActive ? "#b30000" : "#007f00");
                                        border: 1px solid @(user.IsActive ? "#b30000" : "#007f00");">
                                                @(user.IsActive ? "Block" : "Unblock")
                                            </button>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <button type="button"
                                            class="btn open-delete-modal border-0 bg-transparent p-0"
                                            data-user-id="@user.Id"
                                            style="width: 24px; height: 24px; outline: none; box-shadow: none;">
                                        <img src="~/images/delete.png" alt="Delete" style="width: 100%; height: 100%; cursor: pointer;" />
                                    </button>
                                </td>
                            </tr>
                            counter++; // Increment counter
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>

    <div class="modal fade" id="userInfoModal" tabindex="-1" aria-labelledby="userInfoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white" style="border-radius: 5rem;">
                <div class="modal-header border-0">
                    <button type="button" class="btn-close btn-close-white ms-auto me-4 mt-4" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" style="padding: 80px;">
                    <p><span class="modal-label">ID:</span> <span id="modalUserId"></span></p>
                    <p><span class="modal-label">Name:</span> <span id="modalUserName"></span></p>
                    <p><span class="modal-label">Email:</span> <span id="modalUserEmail"></span></p>
                    <p><span class="modal-label">Role:</span> <span id="modalUserRole"></span></p>
                    <p><span class="modal-label">Created:</span> <span id="modalUserCreated"></span></p>
                    <p><span class="modal-label">Phone:</span> <span id="modalUserPhone"></span></p>
                    <p><span class="modal-label">Gender:</span> <span id="modalUserGender"></span></p>
                    <p>
                        <span class="modal-label">Status:</span>
                        <span id="modalUserStatus" class="px-2 py-1 rounded-2 text-white fw-bold"></span>
                    </p>
                    <div class="d-flex justify-content-end mt-3">
                        @using (Html.BeginForm("DeleteUser", "Admin", new { area = "Admin" }, FormMethod.Post))
                        {
                            @Html.Hidden("userId", null, new { id = "modalDeleteUserId" })
                            <button type="button" class="btn text-white px-4" style="background-color: #A11313;" id="confirmDeleteBtn">
                                Delete
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header p-5">
                    <h5 class="modal-title" id="deleteConfirmModalLabel">Confirm Deletion</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-5">
                    Are you sure you want to delete this user?
                </div>
                <div class="modal-footer p-5">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="deleteUserConfirmBtn">Yes, Delete</button>
                </div>
            </div>
        </div>
    </div>

</div>


@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <script>
        $(document).ready(function () {
            var table = $('#userTable').DataTable({
                "paging": true,
                "searching": true,
                "ordering": true,
                "columnDefs": [
                    { "orderable": false, "targets": "_all" }
                ],
                "info": true,
                "lengthChange": false,
                "pageLength": 10,
                "language": {
                    "emptyTable": "No users found",
                    "paginate": {
                        "previous": "<",
                        "next": ">"
                    },
                    "search": "",
                    "searchPlaceholder": "Search users..."
                }
            });

            $('#sortSelect').on('change', function () {
                const val = $(this).val();
                if (!val) {
                    table.order([]).draw();
                    return;
                }

                const [colIndex, dir] = val.split('-');
                table.order([parseInt(colIndex), dir]).draw();
            });

            let searchBox = $('#userTable_filter input');
            let searchLabel = $('#userTable_filter label');
            let searchWrapper = $('#customSearchWrapper');

            searchBox.addClass('form-control form-control-sm bg-light text-dark border-0');
            searchBox.wrap('<div class="input-group"></div>');
            searchBox.before('<span class="input-group-text bg-white"><i class="bi bi-search"></i></span>');

            searchWrapper.append(searchBox.closest('.input-group'));
            searchLabel.remove();

        });
        let deleteForm;

        $('#confirmDeleteBtn').on('click', function () {
            deleteForm = $(this).closest('form');
            const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            modal.show();
        });

        $('#deleteUserConfirmBtn').on('click', function () {
            if (deleteForm) {
                deleteForm.submit();
            }
        });

        $(document).on('click', '.open-delete-modal', function () {
            const userId = $(this).data('user-id');
            $('#modalDeleteUserId').val(userId);

            // Find the form inside the modal to submit
            deleteForm = $('#modalDeleteUserId').closest('form');

            const modal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            modal.show();
        });




        $(document).on('click', '.user-row', function (e) {
            if (
                $(e.target).closest("form").length > 0 ||
                $(e.target).closest(".open-delete-modal").length > 0
            ) return;

            const rowData = $('#userTable').DataTable().row(this).data();
            $('#modalUserId').text(rowData[0]);
            $('#modalUserName').text(rowData[1]);
            $('#modalUserEmail').text(rowData[2]);
            $('#modalUserRole').text(rowData[3]);
            $('#modalUserCreated').text(rowData[4]);


            $('#modalUserPhone').text($(this).data('phone'));
            $('#modalUserGender').text($(this).data('gender'));
            $('#modalUserStatus').text($(this).data('status'));
            const status = $(this).data('status');
            const statusElement = $('#modalUserStatus');
            statusElement.text(status);
            if (status === 'Active') {
                statusElement.removeClass('bg-danger').addClass('bg-success');
            } else {
                statusElement.removeClass('bg-success').addClass('bg-danger');
            }
            $('#modalDeleteUserId').val(rowData[0]);

            const modal = new bootstrap.Modal(document.getElementById('userInfoModal'));
            modal.show();
        });

    </script>
}
