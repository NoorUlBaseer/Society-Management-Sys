<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Society Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />


    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            margin: 0;
            padding: 0;
            display: flex;
            min-height: 100vh;
            background: linear-gradient(to bottom, #0b1e0d, #1f3d1b);
        }

        .sidebar {
            width: 250px;
            background-color: #1c1c1c;
            color: #fff;
            padding-top: 2rem;
            border-top-right-radius: 40px;
            border-bottom-right-radius: 40px;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

            .sidebar.collapsed {
                width: 70px;
            }

            .sidebar h2 {
                font-size: 1.5rem;
                font-weight: bold;
                text-align: center;
                margin-bottom: 2rem;
                color: #d1d1d1;
                transition: opacity 0.3s;
            }

            .sidebar.collapsed h2 {
                opacity: 0;
            }

            .sidebar a {
                display: flex;
                align-items: center;
                padding: 10px 20px;
                margin: 10px 20px 10px 0;
                border-radius: 0 10px 10px 0;
                color: #ccc;
                text-decoration: none;
                transition: background 0.2s ease, color 0.2s ease;
                white-space: nowrap;
            }

                .sidebar a.active {
                    background-color: #2e5f2c;
                    color: #fff;
                }

                .sidebar a:hover {
                    background-color: #355e35;
                    color: #fff;
                }

            .sidebar.collapsed a {
                justify-content: center;
                padding: 10px;
            }

                .sidebar.collapsed a span {
                    display: none;
                }

            .sidebar i {
                font-size: 1.2rem;
                min-width: 1.5rem;
                text-align: center;
            }

        .sidebar-toggler {
            background: none;
            border: none;
            color: #ccc;
            margin-left: 1rem;
            font-size: 1.5rem;
        }

        .main-content {
            flex-grow: 1;
            color: #fff;
            padding: 2rem;
            width: 100%;
        }

        footer {
            background-color: #1c1c1c;
            color: #ccc;
            padding: 1rem;
            text-align: center;
        }

        table.dataTable thead th {
            text-align: center !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            margin: 0 6px;
        }

        .pagination .page-item.active .page-link {
            background-color: mediumpurple;
            border-color: white;
            color: lightgrey;
        }

        .page-link{
            border-radius: 10px !important;
            color: black;
        }

            button:focus,
            button:active,
            .page-link:focus,
            .page-link:active,
            .paginate_button:focus,
            .paginate_button:active {
                outline: none;
                box-shadow: none;
            }
        /* Remove border on search input */
        #customSearchWrapper input.form-control {
            border: none !important;
            box-shadow: none !important;
        }

        /* Optional: remove border on the input group wrapper too */
        #customSearchWrapper .input-group-text {
            border: none !important;
            background-color: transparent !important;
        }

    </style>
</head>
<body>
    <!-- Sidebar -->
    <div id="sidebar" class="sidebar collapsed">
        <button class="sidebar-toggler" onclick="toggleSidebar()" title="Toggle Sidebar">
            <i class="bi bi-list"></i>
        </button>

        <h2>CIVICNEST</h2>

        <a href="@Url.Action("Dashboard", "Admin", new { area = "Admin" })"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="bi bi-bar-chart"></i>
            <span>Statistics</span>
        </a>

        <a href="@Url.Action("ManageComplaints", "Admin", new { area = "Admin" })"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ManageComplaints" ? "active" : "")">
            <i class="bi bi-exclamation-diamond"></i>
            <span>Check Complaints</span>
        </a>

        <a href="@Url.Action("ManageUsers", "Admin", new { area = "Admin" })"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ManageUsers" ? "active" : "")">
            <i class="bi bi-people"></i>
            <span>Edit Users</span>
        </a>

        <a href="@Url.Action("ManageStaff", "Admin", new { area = "Admin" })"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ManageStaff" ? "active" : "")">
            <i class="bi bi-person-gear"></i>
            <span>Staff</span>
        </a>

        <a href="@Url.Action("ManageAssets", "Admin", new { area = "Admin" })"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ManageAssets" ? "active" : "")">
            <i class="bi bi-house-gear"></i>
            <span>Listings</span>
        </a>

        <a href="@Url.Action("Logout", "Account", new { area = "Admin" })"
           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "ManageAssets" ? "active" : "")" style="background: #dc3545;">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
        </a>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <main role="main">
            @RenderBody()
        </main>

        <footer class="mt-auto">
            &copy; @DateTime.Now.Year - Society Management System
        </footer>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
            localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
        }

        // Set correct state on page load
        window.addEventListener('DOMContentLoaded', () => {
            const sidebar = document.getElementById('sidebar');
            const isCollapsed = localStorage.getItem('sidebarCollapsed');

            if (isCollapsed === 'false') {
                sidebar.classList.remove('collapsed');
            }
        });
    </script>



    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
