<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kokoro&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: linear-gradient(to bottom, black, #408350);
            color: white;
            font-family: 'Kokoro', sans-serif;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        h1 {
            font-family: 'Julius Sans One', sans-serif;
        }

        .navbar {
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

		    .navbar-brand img {
                max-width: 300px;
                height: auto;
            }

            .navbar .btn-nav {
                border-radius: 20px;
                margin: 0 5px;
                background-color: rgba(255, 255, 255, 0.1);
                color: white;
            }

                .navbar .btn-nav:hover {
                    background-color: rgba(255, 255, 255, 0.2);
                }

        .hero-section {
            text-align: center;
            padding: 80px 20px;
        }

            .hero-section p {
                max-width: 600px;
                margin: auto;
            }

        .get-started-btn {
            margin-top: 20px;
            background-color: orange;
            border: none;
            color: white;
            padding: 10px 20px;
            border-radius: 20px;
            font-weight: bold;
        }


        .bottom-background {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 200px;
            background: url('@Url.Content("~/images/background.png")') no-repeat center bottom;
            background-size: auto 200px;
            background-repeat: repeat-x;
            pointer-events: none;
            z-index: -1;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            @* <a class="navbar-brand text-white " href="@Url.Action("Dashboard", "Buyer", new { area = "Buyer" })">CIVICNEST</a> *@
            <a class="navbar-brand" href="@Url.Action("Dashboard", "Buyer", new { area = "Buyer" })">
                <img src="~/images/logo.png" alt="CivicNest Logo" />
            </a>

            <div class="ms-auto">
                <a href="@Url.Action("AboutUs", "Buyer", new { area = "Buyer" })" class="btn btn-nav">About</a>

                <a href="@Url.Action("Index", "Buyer", new { area = "Buyer" })" class="btn btn-nav">Assets</a>
                <a href="@Url.Action("MyBookings", "Buyer", new { area = "Buyer" })" class="btn btn-nav">My Bookings</a>
                <a href="@Url.Action("Profile", "Buyer", new { area = "Buyer" })" class="btn btn-nav"> <i class="bi bi-person-fill"></i></a>
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>
  
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>


    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>