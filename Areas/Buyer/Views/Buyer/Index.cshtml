@model IEnumerable<SocietyMng.Data.Entities.Asset>

@{
    ViewData["Title"] = "Available Assets";
}

<h2>Available Assets</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Description</th>
            <th>Block</th>
            <th>Type</th>
            <th>Price</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var asset in Model)
        {
            <tr>
                <td>@asset.Description</td>
                <td>@asset.Block?.Description</td>
                <td>@asset.PropertyType?.Description</td>
                <td>@asset.Price.ToString("C")</td>
                <td>@asset.Status?.Code</td>
                <td>
                    <a asp-area="Buyer" asp-controller="Buyer" asp-action="Details" asp-route-id="@asset.Id" class="btn btn-info btn-sm">
                        View
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>
