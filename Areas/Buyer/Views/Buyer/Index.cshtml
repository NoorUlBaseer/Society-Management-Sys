@model IEnumerable<SocietyMng.Data.Entities.Asset>

@{
    ViewData["Title"] = "Available Assets";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kokoro&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            min-height: 100vh;
        }

        body {
            background: linear-gradient(to bottom, black, #408350);
            color: white;
            position: relative;
            font-family: 'Kokoro', sans-serif !important;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        h1, .display-4 {
            font-family: 'Julius Sans One', sans-serif !important;
            font-size: 2rem;
        }

        .table-responsive {
            background-color: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            padding: 2rem;
        }

        .table {
            color: white;
        }

            .table th {
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            .table td {
                border-top: 1px solid rgba(255, 255, 255, 0.1);
            }

        .badge {
            font-size: 0.75em;
        }

        .clickable-row {
            cursor: pointer;
            transition: background-color 0.2s;
        }

            .clickable-row:hover {
                background-color: rgba(255, 255, 255, 0.1);
            }

        .form-control, .form-select {
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
        }

            .form-control:focus, .form-select:focus {
                background-color: rgba(255, 255, 255, 0.2);
                color: white;
                border-color: rgba(255, 255, 255, 0.3);
                box-shadow: 0 0 0 0.25rem rgba(255, 255, 255, 0.1);
            }

        .input-group-text {
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: white;
        }
    </style>
</head>
<body>
    <div class="container d-flex justify-content-center poppins-font">
        <div class="table-responsive m-4 p-5 rounded-5" style="max-width: 1200px; width: 100%;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="m-0">Available Assets (@Model.Count())</h1>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="mb-3 d-flex justify-content-end">
                <div class="d-flex align-items-center gap-3 flex-wrap p-2 rounded" style="background-color: rgba(255, 255, 255, 0.1);">
                    <div id="customSearchWrapper" class="d-flex align-items-center"></div>
                    <div class="d-flex align-items-center px-2">
                        <label class="me-2 fw-bold m-0" for="sortSelect">Sort by:</label>
                        <select id="sortSelect" class="form-select form-select-sm border-0 p-0 bg-transparent" style="width: auto; box-shadow: none;">
                            <option value="">None</option>
                            <option value="1-asc">Description ↑</option>
                            <option value="1-desc">Description ↓</option>
                            <option value="2-asc">Block ↑</option>
                            <option value="2-desc">Block ↓</option>
                            <option value="4-asc">Price ↑</option>
                            <option value="4-desc">Price ↓</option>
                        </select>
                    </div>
                </div>
            </div>

            @if (Model.Any())
            {
                <table id="assetTable" class="table w-100">
                    <thead>
                        <tr class="text-center">
                            <th class="fw-normal px-3 py-2">Description</th>
                            <th class="fw-normal px-3 py-2">Block</th>
                            <th class="fw-normal px-3 py-2">Type</th>
                            <th class="fw-normal px-3 py-2">Price</th>
                            <th class="fw-normal px-3 py-2">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in Model)
                        {
                            var detailsUrl = Url.Action(
                            "Details",
                            "Buyer",
                            new { area = "Buyer", id = asset.Id }
                            );
                            <tr class="text-center clickable-row"
                                onclick="window.location='@detailsUrl'"
                                data-id="@asset.Id"
                                data-description="@asset.Description"
                                data-address="@asset.Address"
                                data-plot="@asset.PlotNumber"
                                data-price="@asset.Price.ToString("C")"
                                data-block="@asset.Block?.Description"
                                data-type="@asset.PropertyType?.Description"
                                data-status="@asset.Status?.Description"
                                data-date="@asset.DateUploaded.ToString("dd/MM/yyyy")"
                                data-image="@asset.ImagePath">
                                <td class="text-start">@asset.Description</td>
                                <td>@asset.Block?.Description</td>
                                <td>
                                    <span class="badge bg-secondary">@asset.PropertyType?.Description</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">@asset.Price.ToString("C")</span>
                                </td>
                                <td>
                                    <span class="badge bg-success">@asset.Status?.Code</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-home fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No Assets Available</h4>
                </div>
            }
        </div>
    </div>

    <div class="modal fade" id="assetModal" tabindex="-1" aria-labelledby="assetModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark text-white" style="border-radius: 5rem;border: 3px solid #ffffff;">
                <div class="modal-body px-5 py-5">
                    <div class="row g-5">
                        <div class="col-md-5 text-center d-flex align-items-center justify-content-center">
                            <img id="modalAssetImage"
                                 src=""
                                 alt="Asset Image"
                                 class="img-fluid rounded-4 shadow"
                                 style="max-height: 300px; width: 100%; object-fit: cover;border: 1.5px solid #ffffff;" />
                        </div>

                        <div class="col-md-7">
                            <p><span class="modal-label">ID:</span> <span id="modalAssetId"></span></p>
                            <p><span class="modal-label">Description:</span> <span id="modalAssetDescription"></span></p>
                            <p><span class="modal-label">Address:</span> <span id="modalAssetAddress"></span></p>
                            <p><span class="modal-label">Plot No.:</span> <span id="modalAssetPlot"></span></p>
                            <p><span class="modal-label">Price:</span> <span id="modalAssetPrice"></span></p>
                            <p><span class="modal-label">Block:</span> <span id="modalAssetBlock"></span></p>
                            <p><span class="modal-label">Type:</span> <span id="modalAssetType"></span></p>
                            <p><span class="modal-label">Status:</span> <span id="modalAssetStatus"></span></p>
                            <p><span class="modal-label">Date Uploaded:</span> <span id="modalAssetDate"></span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                var table = $('#assetTable').DataTable({
                    paging: true,
                    searching: true,
                    ordering: true,
                    info: true,
                    lengthChange: false,
                    pageLength: 10,
                    language: {
                        emptyTable: "No assets found",
                        paginate: {
                            previous: "<",
                            next: ">"
                        },
                        search: "",
                        searchPlaceholder: "Search assets..."
                    }
                });

                $('#sortSelect').on('change', function () {
                    const val = $(this).val();
                    if (!val) {
                        table.order([]).draw();
                        return;
                    }

                    const [colIndex, dir] = val.split('-');
                    table.order([parseInt(colIndex), dir]).draw();
                });

                let searchBox = $('#assetTable_filter input');
                let searchLabel = $('#assetTable_filter label');
                let searchWrapper = $('#customSearchWrapper');

                searchBox.addClass('form-control form-control-sm border-0');
                searchBox.wrap('<div class="input-group"></div>');
                searchBox.before('<span class="input-group-text"><i class="bi bi-search"></i></span>');

                searchWrapper.append(searchBox.closest('.input-group'));
                searchLabel.remove();
            });

            $(document).on('click', '.clickable-row', function (e) {
                if ($(e.target).is('a, button, input, select, textarea')) {
                    return;
                }
                window.location = $(this).data('href');
            });
        </script>
    }
</body>
</html>