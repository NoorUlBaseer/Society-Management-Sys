@model IEnumerable<SocietyMng.Data.Entities.Asset>

@{
    ViewData["Title"] = "Available Assets";
}

<h2>Available Assets</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<style>
    .clickable-row {
        cursor: pointer;
    }

        .clickable-row:hover {
            background-color: #f5f5f5;
        }
</style>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Description</th>
            <th>Block</th>
            <th>Type</th>
            <th>Price</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var asset in Model)
        {
            // Moved the variable declaration to the same scope as the row
            var detailsUrl = Url.Action(
            "Details",
            "Buyer",
            new { area = "Buyer", id = asset.Id }
            );
            <tr class="clickable-row" onclick="window.location='@detailsUrl'">
                <td>@asset.Description</td>
                <td>@asset.Block?.Description</td>
                <td>@asset.PropertyType?.Description</td>
                <td>@asset.Price.ToString("C")</td>
                <td>@asset.Status?.Code</td>
            </tr>
        }
    </tbody>
</table>