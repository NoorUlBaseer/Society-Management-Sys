@model IEnumerable<SocietyMng.Data.Entities.Asset>

@{
    ViewData["Title"] = "Available Assets";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kokoro&display=swap" rel="stylesheet">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            min-height: 100vh;
        }

        body {
            background: linear-gradient(to bottom, black, #408350);
            color: white;
            position: relative;
            font-family: 'Kokoro', sans-serif !important;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        h1, .display-4 {
            font-family: 'Julius Sans One', sans-serif !important;
            font-size: 2rem;
        }

        .clickable-row {
            cursor: pointer;
        }

            .clickable-row:hover {
                background-color: #f5f5f5;
            }
    </style>
</head>
<body>

    <h1>Available Assets</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }


    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Description</th>
                <th>Block</th>
                <th>Type</th>
                <th>Price</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asset in Model)
            {
                // Moved the variable declaration to the same scope as the row
                var detailsUrl = Url.Action(
                "Details",
                "Buyer",
                new { area = "Buyer", id = asset.Id }
                );
                <tr class="clickable-row" onclick="window.location='@detailsUrl'">
                    <td>@asset.Description</td>
                    <td>@asset.Block?.Description</td>
                    <td>@asset.PropertyType?.Description</td>
                    <td>@asset.Price.ToString("C")</td>
                    <td>@asset.Status?.Code</td>
                </tr>
            }
        </tbody>
    </table>
  </body>
</html>