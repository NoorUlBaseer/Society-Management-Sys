@model SocietyMng.Areas.Buyer.DTOs.AssetBookingConfirmationView

@{
    ViewData["Title"] = "Confirm Your Booking";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kokoro&display=swap" rel="stylesheet">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            min-height: 100vh;
        }

        body {
            background: linear-gradient(to bottom, black, #408350);
            color: white;
            position: relative;
            font-family: 'Kokoro', sans-serif !important;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        h1, .display-4 {
            font-family: 'Julius Sans One', sans-serif !important;
            font-size: 2rem;
        }
    </style>
</head>
<body>
    <h2>@ViewData["Title"]</h2>

    <div class="card p-4 mb-4">
        <h4>@Model.Description</h4>
        <p><strong>Price:</strong> @Model.Price.ToString("C")</p>
    </div>

    <form asp-action="BookAsset" method="post">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.AssetId)

        <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="confirm" required>
            <label class="form-check-label" for="confirm">
                I confirm that I want to book this asset.
            </label>
        </div>

        <button type="submit" class="btn btn-primary">Confirm Booking</button>
        <a asp-action="AssetDetails" asp-route-id="@Model.AssetId" class="btn btn-secondary">Back to Details</a>
    </form>
</body>
</html>
