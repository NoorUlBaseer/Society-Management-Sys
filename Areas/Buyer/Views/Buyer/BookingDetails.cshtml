@model SocietyMng.Data.Entities.Booking

@{
    ViewData["Title"] = "Booking Details";
    Layout = "_Layout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kokoro&display=swap" rel="stylesheet">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            min-height: 100vh;
        }

        body {
            background: linear-gradient(to bottom, black, #408350);
            color: white;
            font-family: 'Kokoro', sans-serif !important;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        h2 {
            font-family: 'Julius Sans One', sans-serif !important;
            font-size: 2rem;
            margin-bottom: 20px;
            text-align: center;
        }

        .booking-container {
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 25px;
            max-width: 900px;
            margin: 40px auto;
            backdrop-filter: blur(8px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .booking-header {
            font-size: 1.5rem;
            font-weight: bold;
            color: #e0e0e0;
            margin-bottom: 15px;
        }

        .booking-details p {
            font-size: 1.1rem;
            margin-bottom: 10px;
        }

        .btn-cancel {
            background-color: #c0392b;
            color: white;
            border-radius: 30px;
            padding: 10px 20px;
            transition: all 0.3s ease;
        }

            .btn-cancel:hover {
                background-color: #e74c3c;
            }

        .status-badge {
            font-size: 1rem;
            padding: 5px 12px;
            border-radius: 15px;
        }

        .status-pending {
            background-color: #f1c40f;
            color: black;
        }

        .status-confirmed {
            background-color: #2ecc71;
        }

        .status-cancelled {
            background-color: #e74c3c;
        }
    </style>
</head>
<body>

    <div class="booking-container">
        <h2>@ViewData["Title"]</h2>

        <div class="booking-header">
            <i class="bi bi-calendar-check"></i> Booking #@Model.Id
        </div>

        <div class="booking-details">
            <p><strong>Asset:</strong> @Model.Asset.Description</p>
            <p><strong>Price: Rs. </strong> @Model.Asset.Price</p>
            <p><strong>Booking Date:</strong> @Model.BookingDate.ToString("yyyy-MM-dd HH:mm")</p>
            <p>
                <strong>Status:</strong>
                <span class="status-badge
                    @(Model.Status == "Pending" ? "status-pending" :
                                            Model.Status == "Confirmed" ? "status-confirmed" : "status-cancelled")">
                    @Model.Status
                </span>
            </p>
        </div>

        @if (Model.Status == "Pending")
        {
            <form asp-action="CancelBooking" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookingId" value="@Model.Id" />
                <button type="submit" class="btn btn-cancel">
                    <i class="bi bi-x-circle"></i> Cancel Booking
                </button>
            </form>
        }
        else
        {
            <p class="text-muted mt-4">This booking cannot be modified.</p>
        }
    </div>
    <div class="bottom-background"></div>

</body>
</html>
