@model SocietyMng.Data.Entities.Asset
@{
    ViewData["Title"] = "Asset Details";
    Layout = "_Layout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kokoro&display=swap" rel="stylesheet">
    <style>
        body {

            background: linear-gradient(to bottom, black, #408350);
            color: black;
            font-family: 'Kokoro', sans-serif;
            min-height: 100vh;
        }

        .navbar {
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-family: 'Julius Sans One', sans-serif;
            color: white !important;
            font-size: 1.5rem;
            font-weight: bold;
            letter-spacing: 2px;
        }

        .property-card {
            background-color: white;
            border-radius: 10px;
            padding: 1.5rem;
            margin-top: 80px;
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            align-items: flex-start;
        }

        .property-img {
            flex: 1 1 45%;
        }

            .property-img img {
                width: 100%;
                border-radius: 10px;
                box-shadow: 0px 4px 15px rgba(0,0,0,0.4);
            }

        .property-details {
            flex: 1 1 50%;
        }

        .property-title {
            font-family: 'Julius Sans One', sans-serif;
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .property-price {
            font-size: 1.3rem;
            font-weight: bold;
            margin-top: 1rem;
        }

        .btn-book {
            background-color: black;
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 20px;
            color: white;
            font-weight: bold;
        }

            .btn-book:hover {
                background-color: #222;
            }
    </style>
</head>
<body class="container py-5">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="property-card">
        <div class="property-img">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" alt="Asset Image"
                     onerror="this.src='/images/no-image.png'; this.onerror=null;" />
            }
            else
            {
                <div class="bg-light text-dark d-flex align-items-center justify-content-center"
                     style="width:100%;height:300px;border-radius:10px;">
                    <i class="bi bi-image" style="font-size: 3rem;"></i>
                </div>
            }
        </div>

        <div class="property-details">
            <h3 class="property-title">House # @Model.Id, @Model.Block?.Description</h3>
            <p>@Model.Description</p>
            <p><strong>Type:</strong> @Model.PropertyType?.Description</p>
            <br /><br />
            <p><strong>Status:</strong> @Model.Status?.Code</p>
            <div class="property-price">Price: @Model.Price.ToString("N2")</div>

            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#bookingModal">
                Book Now
            </button>
        </div>
    </div>

    <div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="bookingModalLabel">Confirm Booking</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to book this property?</p>
                    <p><strong>House # @Model.Id, @Model.Block?.Description</strong></p>
                    <p>Price: @Model.Price.ToString("N2")</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form action="@Url.Action("Book", "Buyer", new { area = "Buyer", id = Model.Id })" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary">Confirm Booking</button>
                    </form>

                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    }
</body>
</html>
