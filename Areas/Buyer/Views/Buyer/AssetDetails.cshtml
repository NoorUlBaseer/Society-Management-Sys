@model SocietyMng.Data.Entities.Asset

@{
    ViewData["Title"] = Model.Id;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("Dashboard")">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("AssetListing")">Available Assets</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.Id</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Asset Details -->
        <div class="col-lg-8">
            <div class="card">
                <div class="asset-hero">
                    <div class="asset-image-large">
                        <i class="fas fa-home fa-5x text-white"></i>
                        <div class="price-overlay">
                            <h2 class="text-white mb-0">@Model.Price.ToString("C")</h2>
                        </div>
                        <div class="status-overlay">
                            <span class="badge @(Model.Status.Code == "AVAILABLE" ? "bg-success" : "bg-warning") fs-6">
                                @Model.Status.Description
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h1 class="card-title">@Model.Id</h1>
                            <p class="lead text-muted">@Model.Description</p>
                        </div>
                        <div class="col-md-4 text-md-end">
                            @if (Model.Status.Code == "AVAILABLE")
                            {
                                <form asp-action="BookAsset" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input name="assetId" type="hidden" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="fas fa-calendar-check mr-2"></i>
                                        Book This Asset
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-lg" disabled>
                                    <i class="fas fa-ban mr-2"></i>
                                    Not Available
                                </button>
                            }
                        </div>
                    </div>

                    <hr class="my-4">

                    <!-- Asset Specifications -->
                    <div class="row">
                        <div class="col-md-6">
                            <h4 class="mb-3">
                                <i class="fas fa-info-circle text-primary mr-2"></i>
                                Property Details
                            </h4>
                            <div class="specification-list">
                                <div class="spec-item">
                                    <span class="spec-label">
                                        <i class="fas fa-building text-muted mr-2"></i>
                                        Block:
                                    </span>
                                    <span class="spec-value">@Model.Block?.Code</span>
                                </div>
                                <div class="spec-item">
                                    <span class="spec-label">
                                        <i class="fas fa-tag text-muted mr-2"></i>
                                        Property Type:
                                    </span>
                                    <span class="spec-value">@Model.PropertyType?.Description</span>
                                </div>
                                <div class="spec-item">
                                    <span class="spec-label">
                                        <i class="fas fa-calendar-plus text-muted mr-2"></i>
                                        Listed On:
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h4 class="mb-3">
                                <i class="fas fa-dollar-sign text-success mr-2"></i>
                                Pricing Information
                            </h4>
                            <div class="pricing-card">
                                <div class="price-main">
                                    <h2 class="text-success mb-0">@Model.Price.ToString("C")</h2>
                                    <small class="text-muted">Total Price</small>
                                </div>

                                @if (Model.Status.Code == "AVAILABLE")
                                {
                                    <div class="alert alert-success mt-3">
                                        <i class="fas fa-check-circle mr-2"></i>
                                        <strong>Available for Booking!</strong><br>
                                        This property is ready for immediate booking.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning mt-3">
                                        <i class="fas fa-exclamation-triangle mr-2"></i>
                                        <strong>Currently Unavailable</strong><br>
                                        This property is @Model.Status.Description.ToLower().
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Quick Actions -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bolt text-primary mr-2"></i>
                        Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (Model.Status.Code == "AVAILABLE")
                        {
                            <form asp-action="BookAsset" method="post">
                                @Html.AntiForgeryToken()
                                <input name="assetId" type="hidden" value="@Model.Id" />
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fas fa-calendar-check mr-2"></i>
                                    Book Now
                                </button>
                            </form>
                        }

                        <a href="@Url.Action("AssetListing")" class="btn btn-outline-primary">
                            <i class="fas fa-arrow-left mr-2"></i>
                            Back to Listings
                        </a>

                        <a href="@Url.Action("CreateComplaint")" class="btn btn-outline-warning">
                            <i class="fas fa-exclamation-triangle mr-2"></i>
                            Report Issue
                        </a>
                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-phone text-success mr-2"></i>
                        Need Help?
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Have questions about this property? Contact our support team.</p>
                    <div class="contact-info">
                        <p class="mb-2">
                            <i class="fas fa-phone text-primary mr-2"></i>
                            <strong>Phone:</strong> +1 (555) 123-4567
                        </p>
                        <p class="mb-2">
                            <i class="fas fa-envelope text-primary mr-2"></i>
                            <strong>Email:</strong> support@society.com
                        </p>
                        <p class="mb-0">
                            <i class="fas fa-clock text-primary mr-2"></i>
                            <strong>Hours:</strong> Mon-Fri 9AM-6PM
                        </p>
                    </div>
                </div>
            </div>

            <!-- Related Properties -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-home text-info mr-2"></i>
                        Similar Properties
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        <i class="fas fa-info-circle mr-1"></i>
                        Browse other properties in the same block or similar price range.
                    </p>
                    <div class="d-grid">
                        <a href="@Url.Action("SearchAssets", new { blockId = Model.BlockId })" class="btn btn-outline-info btn-sm">
                            View Similar Properties
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Booking Confirmation Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="bookingModalLabel">
                    <i class="fas fa-check-circle mr-2"></i>
                    Confirm Booking
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="booking-summary">
                    <h6>Booking Summary:</h6>
                    <ul class="list-unstyled">
                        <li><strong>Property:</strong> @Model.Id</li>
                        <li><strong>Price:</strong> @Model.Price.ToString("C")</li>
                        <li><strong>Block:</strong> @Model.Block?.Code</li>
                        <li><strong>Type:</strong> @Model.PropertyType?.Description</li>
                    </ul>
                </div>
                <div class="alert alert-info">
                    <i class="fas fa-info-circle mr-2"></i>
                    Your booking will be submitted for review. You'll receive a confirmation email once processed.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="BookAsset" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input name="assetId" type="hidden" value="@Model.Id" />
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-check mr-1"></i>
                        Confirm Booking
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Check availability periodically
            setInterval(function() {
                checkAvailability(@Model.Id);
            }, 30000); // Check every 30 seconds

            function checkAvailability(assetId) {
                $.get('@Url.Action("CheckAssetAvailability")', { assetId: assetId })
                    .done(function(data) {
                        if (!data.available && '@Model.Status.Code' === 'AVAILABLE') {
                            location.reload();
                        }
                    });
            }
        });
    </script>
}

<style>
    .asset-image-large {
        height: 300px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        border-radius: 0.375rem 0.375rem 0 0;
    }

    .price-overlay {
        position: absolute;
        bottom: 20px;
        left: 20px;
        background: rgba(0, 0, 0, 0.7);
        padding: 10px 15px;
        border-radius: 0.25rem;
    }

    .status-overlay {
        position: absolute;
        top: 20px;
        right: 20px;
    }

    .specification-list .spec-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px solid #f8f9fa;
    }

        .specification-list .spec-item:last-child {
            border-bottom: none;
        }

    .spec-label {
        font-weight: 500;
        color: #495057;
    }

    .spec-value {
        font-weight: 600;
        color: #212529;
    }

    .pricing-card {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 0.375rem;
        text-align: center;
    }

    .price-main {
        margin-bottom: 1rem;
    }

    .amenities-list .badge {
        font-size: 0.875rem;
        padding: 0.5rem 0.75rem;
    }

    .contact-info p {
        font-size: 0.9rem;
    }

    .asset-hero {
        position: relative;
    }
</style>