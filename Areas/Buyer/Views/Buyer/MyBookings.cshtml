@model IEnumerable<SocietyMng.Data.Entities.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<h2>My Bookings</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Asset</th>
            <th>Block</th>
            <th>Type</th>
            <th>Booking Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.Asset?.Description</td>
                <td>@booking.Asset?.Block?.Description</td>
                <td>@booking.Asset?.PropertyType?.Description</td>
                <td>@booking.BookingDate.ToString("g")</td>
                <td>@booking.Status</td>
                <td>
                    @if (booking.Status != "Cancelled")
                    {
                        <form asp-action="Cancel" method="post">
                            <input type="hidden" name="bookingId" value="@booking.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Back to Assets</a>
