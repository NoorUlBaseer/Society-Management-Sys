@model SocietyMng.Data.Entities.Booking

@{
    ViewData["Title"] = "Booking Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("Dashboard")">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("MyBookings")">My Bookings</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Booking #@Model.Id</li>
                    </ol>
                </nav>
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="page-title">
                            <i class="fas fa-receipt mr-2"></i>
                            Booking Details
                        </h1>
                        <p class="page-subtitle">Booking #@Model.Id - @Model.Asset.Id</p>
                    </div>
                    <div>
                        <span class="badge @GetStatusBadgeClass(Model.Status) fs-5 px-3 py-2">
                            <i class="fas @GetStatusIcon(Model.Status) mr-1"></i>
                            @Model.Status
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Main Booking Information -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-info-circle text-primary mr-2"></i>
                        Booking Information
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-group mb-4">
                                <h6 class="info-label text-muted">
                                    <i class="fas fa-hashtag mr-1"></i>
                                    Booking ID
                                </h6>
                                <p class="info-value h5">#@Model.Id</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-group mb-4">
                                <h6 class="info-label text-muted">
                                    <i class="fas fa-calendar-plus mr-1"></i>
                                    Booking Date
                                </h6>
                                <p class="info-value h5">@Model.BookingDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-group mb-4">
                                <h6 class="info-label text-muted">
                                    <i class="fas fa-clock mr-1"></i>
                                    Created On
                                </h6>
                                <p class="info-value">@Model.CreatedAt.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-group mb-4">
                                <h6 class="info-label text-muted">
                                    <i class="fas fa-flag mr-1"></i>
                                    Current Status
                                </h6>
                                <p class="info-value">
                                    <span class="badge @GetStatusBadgeClass(Model.Status)">@Model.Status</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Property Information -->
            <div class="card mb-4">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-home text-success mr-2"></i>
                        Property Information
                    </h4>
                </div>
                <div class="card-body">
                    <div class="property-showcase">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="property-image">
                                    <i class="fas fa-home fa-5x text-muted"></i>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <h3 class="property-title">@Model.Asset.Id</h3>
                                <p class="property-description text-muted">@Model.Asset.Description</p>

                                <div class="property-specs">
                                    <div class="row">
                                        <div class="col-sm-6 mb-2">
                                            <i class="fas fa-building text-primary mr-2"></i>
                                            <strong>Block:</strong> @Model.Asset.Block?.Code
                                        </div>
                                        <div class="col-sm-6 mb-2">
                                            <i class="fas fa-tag text-primary mr-2"></i>
                                            <strong>Type:</strong> @Model.Asset.PropertyType?.Description
                                        </div>
                                      
                                        <div class="col-sm-6 mb-2">
                                            <i class="fas fa-dollar-sign text-success mr-2"></i>
                                            <strong>Price:</strong> @Model.Asset.Price.ToString("C")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Booking Timeline -->
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-history text-info mr-2"></i>
                        Booking Timeline
                    </h4>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item active">
                            <div class="timeline-marker bg-primary"></div>
                            <div class="timeline-content">
                                <h6 class="timeline-title">Booking Created</h6>
                                <p class="timeline-description">Your booking request was submitted successfully.</p>
                                <small class="timeline-time text-muted">@Model.CreatedAt.ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
                            </div>
                        </div>

                        @if (Model.Status == "Confirmed" || Model.Status == "Cancelled")
                        {
                            <div class="timeline-item active">
                                <div class="timeline-marker @(Model.Status == "Confirmed" ? "bg-success" : "bg-danger")"></div>
                                <div class="timeline-content">
                                    <h6 class="timeline-title">Booking @Model.Status</h6>
                                    <p class="timeline-description">
                                        @if (Model.Status == "Confirmed")
                                        {
                                            <span>Your booking has been confirmed and is now active.</span>
                                        }
                                        else
                                        {
                                            <span>Your booking has been cancelled.</span>
                                        }
                                    </p>
                                    @* <small class="timeline-time text-muted">
                                        @(Model.UpdatedAt?.ToString("MMM dd, yyyy 'at' hh:mm tt") ?? "Date not available")
                                    </small> *@
                                </div>
                            </div>
                        }
                        else if (Model.Status == "Pending")
                        {
                            <div class="timeline-item pending">
                                <div class="timeline-marker bg-warning"></div>
                                <div class="timeline-content">
                                    <h6 class="timeline-title">Awaiting Confirmation</h6>
                                    <p class="timeline-description">Your booking is currently being reviewed by our team.</p>
                                    <small class="timeline-time text-muted">Expected within 24-48 hours</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions Sidebar -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-cogs text-primary mr-2"></i>
                        Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (Model.Status != "Cancelled")
                        {
                            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelBookingModal">
                                <i class="fas fa-times mr-2"></i>
                                Cancel Booking
                            </button>
                        }

                        <a href="@Url.Action("AssetDetails", new { id = Model.AssetId })" class="btn btn-outline-info">
                            <i class="fas fa-eye mr-2"></i>
                            View Property Details
                        </a>

                        <a href="@Url.Action("CreateComplaint")" class="btn btn-outline-warning">
                            <i class="fas fa-exclamation-triangle mr-2"></i>
                            Report Issue
                        </a>

                        <a href="@Url.Action("MyBookings")" class="btn btn-secondary">
                            <i class="fas fa-arrow-left mr-2"></i>
                            Back to Bookings
                        </a>
                    </div>
                </div>
            </div>

            <!-- Booking Summary -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-receipt text-success mr-2"></i>
                        Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="summary-item d-flex justify-content-between mb-2">
                        <span>Property:</span>
                        <strong>@Model.Asset.Id</strong>
                    </div>
                    <div class="summary-item d-flex justify-content-between mb-2">
                        <span>Block:</span>
                        <strong>@Model.Asset.Block?.Code</strong>
                    </div>
                    <div class="summary-item d-flex justify-content-between mb-2">
                        <span>Type:</span>
                        <strong>@Model.Asset.PropertyType?.Description</strong>
                    </div>
                   
                    <hr>
                    <div class="summary-item d-flex justify-content-between">
                        <span class="text-success"><strong>Total Price:</strong></span>
                        <strong class="text-success h5 mb-0">@Model.Asset.Price.ToString("C")</strong>
                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-phone text-success mr-2"></i>
                        Need Help?
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">Contact our support team for assistance with your booking.</p>
                    <div class="contact-info">
                        <p class="mb-2">
                            <i class="fas fa-phone text-primary mr-2"></i>
                            <strong>Phone:</strong> +1 (555) 123-4567
                        </p>
                        <p class="mb-2">
                            <i class="fas fa-envelope text-primary mr-2"></i>
                            <strong>Email:</strong> bookings@society.com
                        </p>
                        <p class="mb-0">
                            <i class="fas fa-clock text-primary mr-2"></i>
                            <strong>Hours:</strong> Mon-Fri 9AM-6PM
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Booking Modal -->
<div class="modal fade" id="cancelBookingModal" tabindex="-1" aria-labelledby="cancelBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="cancelBookingModalLabel">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    Cancel Booking
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-info-circle mr-2"></i>
                    <strong>Important:</strong> Cancelling this booking will make the property available for others to book.
                </div>
                <h6>Booking Details:</h6>
                <ul>
                    <li><strong>Booking ID:</strong> #@Model.Id</li>
                    <li><strong>Property:</strong> @Model.Asset.Id</li>
                    <li><strong>Price:</strong> @Model.Asset.Price.ToString("C")</li>
                </ul>
                <p class="text-danger">
                    <strong>Are you sure you want to cancel this booking?</strong><br>
                    This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep Booking</button>
                <form asp-action="CancelBooking" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-times mr-1"></i>
                        Yes, Cancel Booking
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Auto-refresh status periodically for pending bookings
            @if (Model.Status == "Pending")
            {
                    <text>
                    setInterval(function() {
                        // You can implement real-time status checking here
                        console.log('Checking booking status...');
                    }, 30000); // Check every 30 seconds
                    </text>
            }
        });
    </script>
}

@functions {
    private string GetStatusBadgeClass(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "bg-warning text-dark",
            "confirmed" => "bg-success",
            "cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetStatusIcon(string status)
    {
        return status?.ToLower() switch
        {
            "pending" => "fa-clock",
            "confirmed" => "fa-check-circle",
            "cancelled" => "fa-times-circle",
            _ => "fa-question-circle"
        };
    }
}

<style>
    .page-header {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #dee2e6;
    }

    .info-group {
        position: relative;
    }

    .info-label {
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        font-weight: 600;
        color: #212529;
    }

    .property-showcase {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 0.375rem;
    }

    .property-image {
        height: 150px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 0.375rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .property-title {
        color: #495057;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .property-specs {
        margin-top: 1rem;
        font-size: 0.9rem;
    }

    .timeline {
        position: relative;
        padding-left: 2rem;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 0.75rem;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #dee2e6;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 2rem;
    }

    .timeline-marker {
        position: absolute;
        left: -2rem;
        top: 0.25rem;
        width: 1rem;
        height: 1rem;
        border-radius: 50%;
        border: 3px solid #fff;
        box-shadow: 0 0 0 3px #dee2e6;
    }

    .timeline-item.active .timeline-marker {
        box-shadow: 0 0 0 3px #0d6efd;
    }

    .timeline-item.pending .timeline-marker {
        box-shadow: 0 0 0 3px #ffc107;
        animation: pulse 2s infinite;
    }

    .timeline-title {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.25rem;
    }

    .timeline-description {
        color: #6c757d;
        margin-bottom: 0.5rem;
    }

    .timeline-time {
        font-size: 0.8rem;
    }

    .summary-item {
        font-size: 0.9rem;
    }

    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: none;
    }

    .contact-info p {
        font-size: 0.9rem;
    }
</style>