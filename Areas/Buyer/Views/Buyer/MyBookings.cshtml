@model IEnumerable<SocietyMng.Data.Entities.Booking>
@{
    ViewData["Title"] = "My Bookings";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kokoro&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(to bottom, black, #408350);
            color: white;
            font-family: 'Kokoro', sans-serif !important;
            background-repeat: no-repeat;
            background-attachment: fixed;
            min-height: 100vh;
        }

        .navbar {
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-family: 'Julius Sans One', sans-serif;
            color: white !important;
            font-size: 1.5rem;
            font-weight: bold;
            letter-spacing: 2px;
        }

        h2 {
            font-family: 'Julius Sans One', sans-serif !important;
            text-align: center;
            margin-top: 20px;
            margin-bottom: 30px;
        }

        .booking-card {
            margin-top: 80px;
            background-color: white;
            backdrop-filter: blur(8px);
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
            margin-bottom: 20px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            color: black;
        }

            .booking-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.4);
            }

            .booking-card .card-body {
                padding: 20px;
            }

        .status-badge {
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: bold;
        }

        .status-pending {
            background-color: #f1c40f;
            color: black;
        }

        .status-confirmed {
            background-color: #2ecc71;
        }

        .status-cancelled {
            background-color: #e74c3c;
        }

        .booking-actions .btn {
            border-radius: 20px;
            font-size: 0.85rem;
            padding: 6px 14px;
        }

        .no-bookings {
            text-align: center;
            margin-top: 60px;
        }

            .no-bookings i {
                font-size: 3rem;
                color: rgba(255,255,255,0.4);
                margin-bottom: 15px;
            }
    </style>
</head>
<body>

    <div class="container">
        <h2>@ViewData["Title"]</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success text-center">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger text-center">@TempData["Error"]</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="no-bookings">
                <i class="bi bi-calendar-x"></i>
                <h4>No Bookings Found</h4>
                <p>You haven't made any bookings yet.</p>
                <a asp-area="Buyer" asp-controller="Buyer" asp-action="Index" class="btn btn-light">
                    <i class="bi bi-search"></i> Browse Available Assets
                </a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var booking in Model.OrderByDescending(b => b.BookingDate))
                {
                    var statusClass = booking.Status.ToLower() switch
                    {
                        "pending" => "status-pending",
                        "confirmed" => "status-confirmed",
                        "cancelled" => "status-cancelled",
                        _ => "badge bg-secondary"
                    };

                    <div class="col-md-6 col-lg-4">
                        <div class="booking-card">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <i class="bi bi-calendar-check"></i> Booking #@booking.Id
                                </h5>
                                @if (booking.Asset != null)
                                {
                                    <p><strong>@booking.Asset.Description</strong></p>
                                    <p class="mb-1"><i class="bi bi-cash"></i> PKR @booking.Asset.Price.ToString("N0")</p>
                                }
                                else
                                {
                                    <p class="text-warning">Asset info not available</p>
                                }
                                <p class="mb-1"><i class="bi bi-clock"></i> @booking.BookingDate.ToString("dd MMM yyyy hh:mm tt")</p>
                                <span class="status-badge @statusClass">@booking.Status</span>

                                <div class="booking-actions mt-3">
                                    @if (booking.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form method="post" action="@Url.Action("Cancel", "Buyer", new { area = "Buyer" })" style="display:inline;">
                                            <input type="hidden" name="bookingId" value="@booking.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-x-circle"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                    @if (booking.Asset != null)
                                    {
                                        <a href="@Url.Action("Details", "Buyer", new { area = "Buyer", id = booking.Asset.Id })"
                                           class="btn btn-light btn-sm">
                                            View Asset
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Buyer", new { area = "Buyer" })" class="btn btn-light">Browse Assets</a>
            <a href="@Url.Action("Dashboard", "Buyer", new { area = "Buyer" })" class="btn btn-secondary">Dashboard</a>
        </div>
    </div>

</body>
</html>
