@model IEnumerable<SocietyMng.Data.Entities.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<h2>My Bookings</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <h4>No bookings found</h4>
        <p>You haven't made any bookings yet. <a asp-action="Index" class="alert-link">Browse available assets</a> to make your first booking.</p>
    </div>
}
else
{
    <div class="mb-3">
        <span class="badge bg-primary">Total Bookings: @Model.Count()</span>
        <span class="badge bg-success">Active: @Model.Count(b => b.Status != "Cancelled")</span>
        <span class="badge bg-danger">Cancelled: @Model.Count(b => b.Status == "Cancelled")</span>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Booking ID</th>
                    <th>Asset</th>
                    <th>Block</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Booking Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.OrderByDescending(b => b.BookingDate))
                {
                    <tr class="@(booking.Status == "Cancelled" ? "table-secondary" : "")">
                        <td>
                            <strong>#@booking.Id</strong>
                        </td>
                        <td>
                            @if (booking.Asset != null)
                            {
                                <div>
                                    @booking.Asset.Description
                                    <br />
                                    <small class="text-muted">ID: @booking.AssetId</small>
                                </div>
                            }
                            else
                            {
                                <span class="text-warning">Asset information unavailable (ID: @booking.AssetId)</span>
                            }
                        </td>
                        <td>
                            @(booking.Asset?.Block?.Description ?? "N/A")
                        </td>
                        <td>
                            @(booking.Asset?.PropertyType?.Description ?? "N/A")
                        </td>
                        <td>
                            @if (booking.Asset?.Price != null)
                            {
                                @booking.Asset.Price.ToString("C")
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>
                            <div>
                                @booking.BookingDate.ToString("MMM dd, yyyy")
                                <br />
                                <small class="text-muted">@booking.BookingDate.ToString("HH:mm")</small>
                            </div>
                        </td>
                        <td>
                            @{
                                var statusClass = booking.Status switch
                                {
                                    "Confirmed" => "badge bg-success",
                                    "Pending" => "badge bg-warning text-dark",
                                    "Cancelled" => "badge bg-danger",
                                    _ => "badge bg-secondary"
                                };
                            }
                            <span class="@statusClass">@booking.Status</span>
                        </td>
                        <td>
                            @if (booking.Status != "Cancelled" && booking.Status != "Completed")
                            {
                                <form asp-area="Buyer" asp-controller="Buyer" asp-action="Cancel" method="post"
                                      class="d-inline" onsubmit="return confirmCancel()">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@booking.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-times"></i> Cancel
                                    </button>
                                </form>

                                @if (booking.Asset != null)
                                {
                                    <a asp-area="Buyer" asp-controller="Buyer" asp-action="Details"
                                       asp-route-id="@booking.AssetId" class="btn btn-info btn-sm ms-1">
                                        <i class="fas fa-eye"></i> View Asset
                                    </a>
                                }
                            }
                            else if (booking.Status == "Cancelled")
                            {
                                <span class="text-muted small">Cancelled</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-area="Buyer" asp-controller="Buyer" asp-action="Index" class="btn btn-primary">
        <i class="fas fa-search"></i> Browse Assets
    </a>
    <a asp-area="Buyer" asp-controller="Buyer" asp-action="Dashboard" class="btn btn-secondary">
        <i class="fas fa-dashboard"></i> Dashboard
    </a>
</div>

@section Scripts {
        script>
                                        function confirmCancel() {
                                            return confirm('Are you sure you want to cancel this booking?');
                                        }

                                        // Auto-hide success/error messages after 5 seconds
                                        setTimeout(function() {
                                            $('.alert').fadeOut('slow');
                                        }, 5000);
    </script>
}