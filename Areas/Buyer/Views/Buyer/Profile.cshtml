@model SocietyMng.Areas.Buyer.ModelView.Profile
@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

       

        .navbar {
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-family: 'Julius Sans One', sans-serif;
            color: white !important;
            font-size: 1.5rem;
            font-weight: bold;
            letter-spacing: 2px;
        }

        .nav-pills {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 25px;
            padding: 5px;
        }

            .nav-pills .nav-link {
                color: rgba(255, 255, 255, 0.7);
                border-radius: 20px;
                padding: 8px 20px;
                margin: 0 5px;
                transition: all 0.3s ease;
                border: none;
                background: transparent;
            }

                .nav-pills .nav-link:hover {
                    color: white;
                    background: rgba(255, 255, 255, 0.2);
                }

                .nav-pills .nav-link.active {
                    background: rgba(74, 124, 89, 0.8);
                    color: white;
                }

        .profile-icon {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .profile-icon:hover {
                background: rgba(255, 255, 255, 0.3);
            }

        .main-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 2;
        }

        .profile-header {
            text-align: left;
            margin-bottom: 2rem;
        }

        .profile-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            background: linear-gradient(45deg, #ffffff, #a8d8a8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .profile-card {
            background: transparent;
            border: none;
            border-radius: 0;
            padding: 2.5rem 0;
            box-shadow: none;
            position: relative;
            overflow: hidden;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            color: rgba(255, 255, 255, 0.9);
            font-weight: 500;
            margin-bottom: 0.5rem;
            font-size: 0.95rem;
        }

        .form-control {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            padding: 12px 16px;
            color: white;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                background: rgba(255, 255, 255, 0.12);
                border-color: #6fa06f;
                box-shadow: 0 0 0 3px rgba(111, 160, 111, 0.2);
                color: white;
            }

            .form-control::placeholder {
                color: rgba(255, 255, 255, 0.5);
            }

            .form-control[readonly] {
                background: rgba(255, 255, 255, 0.03);
                border-color: rgba(255, 255, 255, 0.1);
                cursor: not-allowed;
            }

        .info-sidebar {
            background: transparent;
            border: none;
            border-radius: 0;
            padding: 0;
            margin-left: 2rem;
            margin-top: 6rem;
        }

        .info-item {
            margin-bottom: 3rem;
            position: relative;
        }

            .info-item h6 {
                color: white;
                font-weight: 600;
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                font-size: 1rem;
            }

            .info-item p {
                color: rgba(255, 255, 255, 0.7);
                font-size: 0.9rem;
                line-height: 1.6;
                margin: 0;
                padding-left: 2.5rem;
            }

        .info-icon {
            width: 24px;
            height: 24px;
            background: rgba(220, 53, 69, 0.2);
            border: 2px solid #dc3545;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 0.75rem;
            color: #dc3545;
            font-size: 12px;
            flex-shrink: 0;
        }

            .info-icon.security {
                background: rgba(220, 53, 69, 0.2);
                border-color: #dc3545;
                color: #dc3545;
            }

            .info-icon.share {
                background: rgba(220, 53, 69, 0.2);
                border-color: #dc3545;
                color: #dc3545;
            }

        .btn-modern {
            padding: 12px 24px;
            border-radius: 25px;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            min-width: 140px;
        }

        .btn-save {
            background: linear-gradient(45deg, #4a7c59, #6fa06f);
            color: white;
            box-shadow: 0 8px 25px rgba(74, 124, 89, 0.3);
        }

            .btn-save:hover {
                background: linear-gradient(45deg, #3d6b4a, #5e8f5e);
                transform: translateY(-2px);
                box-shadow: 0 12px 35px rgba(74, 124, 89, 0.4);
                color: white;
            }

        .btn-delete {
            background: linear-gradient(45deg, #dc3545, #e55865);
            color: white;
            box-shadow: 0 8px 25px rgba(220, 53, 69, 0.3);
        }

            .btn-delete:hover {
                background: linear-gradient(45deg, #c82333, #d04454);
                transform: translateY(-2px);
                box-shadow: 0 12px 35px rgba(220, 53, 69, 0.4);
                color: white;
            }

        .btn-secondary-modern {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

            .btn-secondary-modern:hover {
                background: rgba(255, 255, 255, 0.2);
                transform: translateY(-2px);
                color: white;
            }

        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .skyline {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 200px;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 200"><path d="M0,200 L0,120 L50,120 L50,80 L100,80 L100,60 L150,60 L150,100 L200,100 L200,40 L250,40 L250,90 L300,90 L300,70 L350,70 L350,110 L400,110 L400,50 L450,50 L450,85 L500,85 L500,45 L550,45 L550,75 L600,75 L600,35 L650,35 L650,95 L700,95 L700,55 L750,55 L750,105 L800,105 L800,65 L850,65 L850,85 L900,85 L900,45 L950,45 L950,115 L1000,115 L1000,75 L1050,75 L1050,95 L1100,95 L1100,85 L1150,85 L1150,105 L1200,105 L1200,200 Z" fill="rgba(0,0,0,0.3)"/></svg>') no-repeat center bottom;
            background-size: cover;
            z-index: 1;
            opacity: 0.6;
        }

        .modal-content {
            background: rgba(30, 30, 30, 0.95);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            color: white;
        }

        .delete-modal {
            background: rgba(200, 200, 200, 0.95);
            backdrop-filter: blur(20px);
            border: none;
            border-radius: 20px;
            color: #333;
            max-width: 400px;
            margin: 0 auto;
        }

            .delete-modal .modal-header {
                border-bottom: none;
                padding: 1.5rem 1.5rem 0;
            }

            .delete-modal .modal-body {
                padding: 1rem 1.5rem 1.5rem;
            }

            .delete-modal .modal-title {
                color: #333;
                font-weight: 600;
                font-size: 1.1rem;
            }

            .delete-modal .btn-close {
                filter: invert(1);
            }

        .delete-form-control {
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 10px 12px;
            color: #333;
            font-size: 0.9rem;
        }

            .delete-form-control:focus {
                background: white;
                border-color: #6fa06f;
                box-shadow: 0 0 0 2px rgba(111, 160, 111, 0.2);
                color: #333;
            }

        .delete-modal .form-label {
            color: #333;
            font-weight: 500;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .modal-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .modal-footer {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .alert {
            background: rgba(74, 124, 89, 0.2);
            border: 1px solid rgba(74, 124, 89, 0.5);
            border-radius: 10px;
            color: white;
            margin-bottom: 1.5rem;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.2);
            border-color: rgba(220, 53, 69, 0.5);
        }

        .text-danger {
            color: #ff6b6b !important;
        }
    </style>
</head>
<body>
    <!-- Main Content -->
    <div class="main-container">
        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row">
            <!-- Main Profile Form -->
            <div class="col-lg-8">
                <div class="profile-header">
                    <h1 class="profile-title">Personal Info</h1>
                </div>

                <div class="profile-card">
                    @using (Html.BeginForm("Profile", "Buyer", new { area = "Buyer" }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.Id)

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter complete email" })
                                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "We display your phone number and personal can get in touch. You can choose who can see your phone number." })
                                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Gender, new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Gender, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.Role, "Role", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.Role, new { @class = "form-control", @readonly = "readonly" })
                                    @Html.HiddenFor(m => m.RoleId)
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.LabelFor(m => m.CreatedAt, "Created At", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.CreatedAt, new { @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label("NewPassword", "New Password", new { @class = "form-label" })
                                    <input type="password" name="NewPassword" class="form-control" placeholder="Enter new password (leave blank to keep current)">
                                    @Html.ValidationMessage("NewPassword", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label("ConfirmNewPassword", "Confirm New Password", new { @class = "form-label" })
                                    <input type="password" name="ConfirmNewPassword" class="form-control" placeholder="Confirm new password">
                                    @Html.ValidationMessage("ConfirmNewPassword", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="action-buttons">
                            <button type="button" class="btn btn-modern btn-delete" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="bi bi-trash me-2"></i>Delete Account
                            </button>

                            <button type="button" class="btn btn-modern btn-save" data-bs-toggle="modal" data-bs-target="#saveModal">
                                <i class="bi bi-check-circle me-2"></i>Save
                            </button>
                            <button type="button" class="btn btn-modern btn-secondary-modern" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Info Sidebar -->
            <div class="col-lg-4">
                <div class="info-sidebar">
                    <div class="info-item">
                        <h6>
                            <div class="info-icon security">
                                <i class="bi bi-lock"></i>
                            </div>
                            Why isn't my info shown here?
                        </h6>
                        <p>We're hiding some account details to protect your identity.</p>
                    </div>

                    <div class="info-item">
                        <h6>
                            <div class="info-icon share">
                                <i class="bi bi-question-circle"></i>
                            </div>
                            What info is shared with others?
                        </h6>
                        <p>CivicNest shows all your information when you submit a booking request, so others can confirm who they're working with.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Skyline Background -->
    <div class="skyline"></div>

    <!-- Save Changes Confirmation Modal -->
    <div class="modal fade" id="saveModal" tabindex="-1" aria-labelledby="saveModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="saveModalLabel">Confirm Profile Update</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Are you sure you want to save these changes?</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-modern btn-secondary-modern" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-modern btn-save" onclick="submitProfileForm()">
                        <i class="bi bi-check-circle me-1"></i> Yes, Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">Confirm Logout</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Are you sure you want to logout?</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-modern btn-secondary-modern" data-bs-dismiss="modal">Cancel</button>
                    <form id="logoutForm" method="post" action="/auth/logout" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-modern btn-save">
                            <i class="bi bi-box-arrow-right me-1"></i> Yes, Logout
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content delete-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirm Delete Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="deleteForm" method="post" action="@Url.Action("DeleteAccount", "Buyer", new { area = "Buyer" })">
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            <label class="form-label">Enter Password</label>
                            <input type="password" name="Password" id="deletePassword" class="form-control delete-form-control" required>
                        </div>

                        <div class="form-group mb-4">
                            <label class="form-label">Write "Confirm" to delete account</label>
                            <input type="text" name="ConfirmText" id="confirmText" class="form-control delete-form-control" required>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-modern btn-delete" id="deleteButton" disabled>
                                Delete Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="bottom-background"></div>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Custom JavaScript -->
    <script>
        function submitProfileForm() {
            // Get the form element
            const form = document.querySelector('form[action*="Profile"]');
            if (form) {
                // Close the modal
                const modal = bootstrap.Modal.getInstance(document.getElementById('saveModal'));
                if (modal) {
                    modal.hide();
                }
                // Submit the form
                form.submit();
            } else {
                console.error('Profile form not found');
                alert('Error: Could not find the profile form to submit.');
            }
        }

        // Delete modal validation
        document.addEventListener('DOMContentLoaded', function() {
            const deletePassword = document.getElementById('deletePassword');
            const confirmText = document.getElementById('confirmText');
            const deleteButton = document.getElementById('deleteButton');

            function validateDeleteForm() {
                const passwordFilled = deletePassword.value.trim() !== '';
                const confirmTextCorrect = confirmText.value.trim().toLowerCase() === 'confirm';

                deleteButton.disabled = !(passwordFilled && confirmTextCorrect);
            }

            if (deletePassword && confirmText && deleteButton) {
                deletePassword.addEventListener('input', validateDeleteForm);
                confirmText.addEventListener('input', validateDeleteForm);
            }
        });
    </script>
</body>
</html>