@model SocietyMng.Areas.Admin.DTOs.AssetCreateView
@{
    ViewData["Title"] = "Create Asset";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        /* Previous CSS remains the same */
        /* ... */
    </style>
</head>
<body>
    <div class="container">
        @using (Html.BeginForm("Create", "Asset", new { area = "Admin" }, FormMethod.Post, true, new { enctype = "multipart/form-data", id = "assetForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-container">
                <div class="left-form">
                    <!-- Previous error display code remains the same -->
                    <!-- ... -->

                    <div class="form-group">
                        @Html.LabelFor(m => m.BlockId, "Block")
                        @Html.DropDownListFor(m => m.BlockId, new SelectList(ViewBag.Blocks as List<SocietyMng.Data.Entities.SystemCodeItem>, "Id", "Description"), "-- Select Block --", new { required = "required" })
                        @Html.ValidationMessageFor(m => m.BlockId, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Address)
                        @Html.TextBoxFor(m => m.Address, new {
                        required = "required",
                                        maxlength = "200",
                                        oninput = "validateAddress(this)"
                                        })
                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                    <span id="addressError" class="text-danger"></span>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Description)
                    @Html.TextAreaFor(m => m.Description, new {
                                        required = "required",
                                        maxlength = "500",
                                        oninput = "validateDescription(this)",
                                        pattern = "^[a-zA-Z].*",
                                        title = "Description must start with a letter"
                                        })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                    <span id="descriptionError" class="text-danger"></span>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.PlotNumber)
                    @Html.TextBoxFor(m => m.PlotNumber, new {
                                        required = "required",
                                        maxlength = "20",
                                        pattern = "^[0-9]+$",
                                        title = "Plot number can only contain digits",
                                        oninput = "validatePlotNumber(this)"
                                        })
                    @Html.ValidationMessageFor(m => m.PlotNumber, "", new { @class = "text-danger" })
                    <span id="plotNumberError" class="text-danger"></span>
                </div>

                <!-- Rest of the form remains the same -->
                <!-- ... -->
            </div>

            <div class="right-form">
                <!-- File upload section remains the same -->
                <!-- ... -->
            </div>
        </div>
                }
    </div>

    <script>
        // Client-side validation functions
        function validateAddress(input) {
            const addressError = document.getElementById('addressError');

            if (input.value.length > 200) {
                addressError.textContent = "Address cannot exceed 200 characters";
                input.classList.add('is-invalid');
                return false;
            } else if (input.value.trim() === "") {
                addressError.textContent = "Address is required";
                input.classList.add('is-invalid');
                return false;
            } else {
                addressError.textContent = "";
                input.classList.remove('is-invalid');
                return true;
            }
        }

        function validateDescription(input) {
            const descriptionError = document.getElementById('descriptionError');
            const startsWithLetter = /^[a-zA-Z]/.test(input.value);

            if (!startsWithLetter && input.value.trim() !== "") {
                descriptionError.textContent = "Description must start with a letter";
                input.classList.add('is-invalid');
                return false;
            } else if (input.value.length > 500) {
                descriptionError.textContent = "Description cannot exceed 500 characters";
                input.classList.add('is-invalid');
                return false;
            } else if (input.value.trim() === "") {
                descriptionError.textContent = "Description is required";
                input.classList.add('is-invalid');
                return false;
            } else {
                descriptionError.textContent = "";
                input.classList.remove('is-invalid');
                return true;
            }
        }

        function validatePlotNumber(input) {
            const plotNumberError = document.getElementById('plotNumberError');
            const onlyDigits = /^[0-9]+$/.test(input.value);

            if (!onlyDigits && input.value.trim() !== "") {
                plotNumberError.textContent = "Plot number can only contain digits";
                input.classList.add('is-invalid');
                return false;
            } else if (input.value.length > 20) {
                plotNumberError.textContent = "Plot number cannot exceed 20 digits";
                input.classList.add('is-invalid');
                return false;
            } else if (input.value.trim() === "") {
                plotNumberError.textContent = "Plot number is required";
                input.classList.add('is-invalid');
                return false;
            } else {
                plotNumberError.textContent = "";
                input.classList.remove('is-invalid');
                return true;
            }
        }

        // Modified form submission handler to prevent form reset
        document.getElementById('assetForm').addEventListener('submit', function(e) {
            let isValid = true;

            // Validate all fields
            const addressInput = document.querySelector('[name="Address"]');
            const descriptionInput = document.querySelector('[name="Description"]');
            const plotNumberInput = document.querySelector('[name="PlotNumber"]');
            const priceInput = document.querySelector('[name="Price"]');
            const imageInput = document.getElementById('ImageFile');

            isValid = validateAddress(addressInput) && isValid;
            isValid = validateDescription(descriptionInput) && isValid;
            isValid = validatePlotNumber(plotNumberInput) && isValid;
            isValid = validatePrice(priceInput) && isValid;
            isValid = validateImageFile(imageInput) && isValid;

            // Check required dropdowns
            const blockSelect = document.querySelector('[name="BlockId"]');
            if (blockSelect.value === "") {
                blockSelect.classList.add('is-invalid');
                isValid = false;
            } else {
                blockSelect.classList.remove('is-invalid');
            }

            const propertyTypeSelect = document.querySelector('[name="PropertyTypeId"]');
            if (propertyTypeSelect.value === "") {
                propertyTypeSelect.classList.add('is-invalid');
                isValid = false;
            } else {
                propertyTypeSelect.classList.remove('is-invalid');
            }

            if (!isValid) {
                e.preventDefault();
                // Scroll to the first error
                const firstError = document.querySelector('.is-invalid');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });

        // Initialize event listeners for real-time validation
        document.querySelector('[name="Address"]').addEventListener('input', function() {
            validateAddress(this);
        });

        document.querySelector('[name="Description"]').addEventListener('input', function() {
            validateDescription(this);
        });

        document.querySelector('[name="PlotNumber"]').addEventListener('input', function() {
            validatePlotNumber(this);
        });

        document.querySelector('[name="Price"]').addEventListener('input', function() {
            validatePrice(this);
        });

        // Keep the existing price and image validation functions
        // ...
    </script>
</body>
</html>