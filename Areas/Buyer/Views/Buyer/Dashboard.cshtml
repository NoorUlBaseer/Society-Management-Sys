@{
    ViewData["Title"] = "Buyer Dashboard";
    // Layout = "_BuyerLayout"; Change if using a different layout for buyers
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CivicNest</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kokoro&display=swap" rel="stylesheet">
    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            min-height: 100vh;
        }

        body {
            background: linear-gradient(to bottom, black, #408350);
            color: white;
            position: relative;
            font-family: 'Kokoro', sans-serif !important;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        h1, .display-4 {
            font-family: 'Julius Sans One', sans-serif !important;
            font-size: 2rem;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1 class="mt-4">Buyer Dashboard</h1>

        <div class="row mt-4">
            <!-- Manage Profile -->
            <div class="col-md-3">
                <div class="card text-white bg-primary mb-3">
                    <div class="card-body">
                        <h5 class="card-title">My Profile</h5>
                        <p class="card-text">View or edit your profile</p>
                        <a href="@Url.Action("Profile", "Buyer")" class="btn btn-light">Manage Profile</a>
                    </div>
                </div>
            </div>

            <!-- Bookings -->
            <div class="col-md-3">
                <div class="card text-white bg-success mb-3">
                    <div class="card-body">
                        <h5 class="card-title">My Bookings</h5>
                        <p class="card-text">View and manage your bookings</p>
                        <a href="@Url.Action("MyBookings", "Buyer")" class="btn btn-light">View Bookings</a>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card text-white bg-info mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Available Assets</h5>
                        <p class="card-text">Browse assets to book</p>
                        <a href="@Url.Action("Index", "Buyer", new { area = "Buyer" })" class="btn btn-light">Browse Assets</a>
                    </div>
                </div>
            </div>

            <!-- Complaints -->
            <div class="col-md-3">
                <div class="card text-white bg-warning mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Complaints</h5>
                        <p class="card-text">Submit a complaint or view status</p>
                        <a href="@Url.Action("MyComplaints", "Buyer")" class="btn btn-light">Make Complaint</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </body>
    </html>
